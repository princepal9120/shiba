# Copy to .env (gitignored) or run `pnpm run bootstrap`, which writes it for you.
# alchemy.run.ts loads this file; every secret present here is bound on deploy,
# and any secret missing here is REMOVED from the Worker on the next deploy.
#
# varlock schema — `pnpm env:load` validates this file against your .env;
# `pnpm env:scan` greps the repo for leaked secret values. Per-account
# secrets (*_SUBSCRIPTION_*_<ACCOUNT>) resolve by name at egress — declare
# the base name here, suffixes need no item.
# @defaultRequired=false @defaultSensitive=false

# --- Dashboard access -------------------------------------------------------

# Cloudflare Access — who can open the dashboard (web + iPhone). Live deploys
# fail closed when empty: no Access binding = REQUIRE_ACCESS hard-401.
# @type=email
ACCESS_EMAILS=you@example.com

# The <x> in https://shiba-ai-coworker.<x>.workers.dev
WORKERS_SUBDOMAIN=

# --- Cloudflare deploy credentials ------------------------------------------

# Optional: skip if `npx alchemy provider cloudflare token` stored a profile
# @sensitive
CLOUDFLARE_API_TOKEN=
# An identifier, not a credential — also embedded in the dogfood container
# image path (registry.cloudflare.com/<id>/...), so not @sensitive.
CLOUDFLARE_ACCOUNT_ID=

# --- Worker secrets (wrangler secret put / alchemy secrets(...)) ------------

# @sensitive
GITHUB_TOKEN=
# @sensitive
AI_GATEWAY_TOKEN=
# @sensitive
SLACK_SIGNING_SECRET=
# @sensitive
SLACK_BOT_TOKEN=
# Comma-separated Slack approver user IDs — not a credential.
SLACK_APPROVERS=
# Slack channel→repo routing map — not a credential.
SLACK_CHANNEL_REPOS=
# @sensitive
GITHUB_WEBHOOK_SECRET=
# @sensitive
TYPESAFE_API_KEY=
# @sensitive
DEVIN_API_KEY=

# T48: the operator's `claude setup-token` output; per-account
# CLAUDE_SUBSCRIPTION_TOKEN_<ACCOUNT> secrets resolve by name at egress.
# @sensitive
CLAUDE_SUBSCRIPTION_TOKEN=

# T49: the operator's `codex login` auth.json contents verbatim; per-account
# CODEX_SUBSCRIPTION_AUTH_JSON_<ACCOUNT> secrets resolve by name at egress.
# @sensitive
CODEX_SUBSCRIPTION_AUTH_JSON=

# cursor-subscription: the operator's Cursor Agent API key; per-account
# CURSOR_SUBSCRIPTION_TOKEN_<ACCOUNT> secrets resolve by name at egress.
# @sensitive
CURSOR_SUBSCRIPTION_TOKEN=

# devin-subscription: the operator's Devin API key/session token; per-account
# DEVIN_SUBSCRIPTION_TOKEN_<ACCOUNT> secrets resolve by name at egress.
# @sensitive
DEVIN_SUBSCRIPTION_TOKEN=

# T51: the bearer the `shiba local` daemon presents on /api/local/*.
# @sensitive
LOCAL_ADAPTER_TOKEN=

# --- Feature flags and model picks (plain vars, never secrets) ---------------

# T48–T50 subscription-harness opt-ins; absent = the harness is dark.
SHIBA_CLAUDE_SUBSCRIPTION=
SHIBA_CODEX_SUBSCRIPTION=
SHIBA_ANTIGRAVITY_SUBSCRIPTION=
# cursor/devin subscription-auth lanes; absent = the surface is dark.
SHIBA_CURSOR_SUBSCRIPTION=
SHIBA_DEVIN_SUBSCRIPTION=
# T51 local-runtime opt-in; absent = runtime:"local" is refused.
SHIBA_LOCAL_RUNTIME=
# Enables the automations scheduler loop.
AUTOMATIONS_ENABLED=
# Enables the memory subsystem (Vectorize + Memory DO).
MEMORY_ENABLED=
# Harness selection for sandbox runs (opencode | claude-code | codex | devin | grok).
AGENT_HARNESS=
# Per-harness model overrides.
CLAUDE_CODE_MODEL=
CLAUDE_SUBSCRIPTION_MODEL=
CODEX_MODEL=
CODEX_SUBSCRIPTION_MODEL=
ANTIGRAVITY_SUBSCRIPTION_MODEL=
CURSOR_SUBSCRIPTION_MODEL=
DEVIN_SUBSCRIPTION_MODEL=
DEVIN_MODEL=
GROK_MODEL=
# Slack channel for approval messages.
SLACK_APPROVALS_CHANNEL=
# Agent mailbox identity — the address `latest_verification` scans when no
# mailbox arg is given (default dev@tryshiba.dev). Plain var, not a secret.
# @type=email
AGENT_MAILBOX=
# Set by alchemy live deploys — do not set locally.
REQUIRE_ACCESS=
# `cloudflare` = alchemy state in CF state store; unset = local state files.
ALCHEMY_STATE_BACKEND=
