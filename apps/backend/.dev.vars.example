# Copy to .dev.vars for local development. Never commit real credentials.
# Non-secret defaults are in wrangler.jsonc.

# Optional, Worker-side PR publishing only. Private cloning is not wired.
# GITHUB_TOKEN=

# Optional Projects v2 board sync: PAT with `project` scope + board number.
# GITHUB_PROJECT_TOKEN=
# GITHUB_PROJECT_NUMBER=

# Optional, HMAC verification of acknowledgment-only GitHub webhooks.
# GITHUB_WEBHOOK_SECRET=

# Optional Slack wiring. SLACK_APPROVERS empty means nobody can approve.
# SLACK_SIGNING_SECRET=
# SLACK_APPROVERS=
# SLACK_BOT_TOKEN=
# JSON map {channelId: "https://github.com/owner/repo"} for bare @mentions.
# SLACK_CHANNEL_REPOS=

# Optional Telegram bot lane. TELEGRAM_APPROVERS empty means nobody can approve.
# TELEGRAM_BOT_TOKEN=
# Secret registered via Bot API setWebhook, echoed back as X-Telegram-Bot-Api-Secret-Token.
# TELEGRAM_WEBHOOK_SECRET=
# TELEGRAM_APPROVERS=
# JSON map {chatId: "https://github.com/owner/repo"} for /shiba without a URL.
# TELEGRAM_CHAT_REPOS=
# Optional harness override, falls back to AGENT_HARNESS.
# TELEGRAM_AGENT_HARNESS=

# Optional Discord interactions lane. DISCORD_APPROVERS empty means nobody can approve.
# Ed25519 public key from the Discord app's General Information page.
# DISCORD_PUBLIC_KEY=
# DISCORD_BOT_TOKEN=
# DISCORD_APPROVERS=
# DISCORD_CHANNEL_REPOS=
# DISCORD_AGENT_HARNESS=
# Optional TypeSafe System One key for run_when (falls back to Workers AI).
# TYPESAFE_API_KEY=

# Optional bearer token for POST /api/trigger (e.g. iPhone Apple Shortcuts).
# Unset disables the route with a 503.
# TRIGGER_TOKEN=

# AI Gateway uses the AI binding and GATEWAY_ID, not a container provider key.
# Optional: sent as cf-aig-authorization on gateway requests (src/egress.ts).
# Required when the gateway is auth-gated or has no BYOK key stored.
# AI_GATEWAY_TOKEN=

# Set to any value to enforce Cloudflare Access on /app and /api locally too.
# REQUIRE_ACCESS=1

