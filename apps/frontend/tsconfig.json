{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "components/*": [
        "./src/components/*"
      ],
      "ui/*": [
        "./src/components/ui/*"
      ],
      "lib/*": [
        "./src/lib/*"
      ],
      "utils": [
        "./src/lib/utils"
      ]
    }
  },
  "include": [
    "src/**/*",
    "vite.config.ts"
  ]
}
