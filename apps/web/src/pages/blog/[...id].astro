---
import type { GetStaticPaths } from 'astro';
import JournalArticle from '../../layouts/JournalArticle.astro';
import { getPublishedPosts, renderPost, type JournalPost } from '../../lib/journal';

export const getStaticPaths = (async () => {
	const posts = await getPublishedPosts();
	// `posts` is newest-first, so the element after this one is the older post
	// and the element before it is the newer one.
	return posts.map((post, index) => ({
		params: { id: post.id },
		props: {
			post,
			older: posts[index + 1]
				? { path: `/blog/${posts[index + 1]!.id}/`, title: posts[index + 1]!.data.title }
				: null,
			newer: posts[index - 1]
				? { path: `/blog/${posts[index - 1]!.id}/`, title: posts[index - 1]!.data.title }
				: null,
		},
	}));
}) satisfies GetStaticPaths;

interface Props {
	post: JournalPost;
	older: { path: string; title: string } | null;
	newer: { path: string; title: string } | null;
}

const { post: entry, older, newer } = Astro.props;
const post = await renderPost(entry);

// Banners are authored text, imported at build time rather than fetched, so
// they cost no request and inherit the active theme. A missing file renders an
// explicit notice on the page instead of failing the build.
const banners = import.meta.glob<string>('../../assets/blog/*.txt', {
	query: '?raw',
	import: 'default',
	eager: true,
});
const banner = banners[`../../assets/blog/${post.post.id}.txt`]?.trim();
---

<JournalArticle post={post} banner={banner} prev={older} next={newer} />
