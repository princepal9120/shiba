  <!-- CLIENT INTERACTIONS SCRIPT -->
  <script>
    // 1. Shiba Mascot Blinking Eyes Animation Cycle
    const f1 = document.getElementById('shiba-frame-1');
    const f2 = document.getElementById('shiba-frame-2');
    const f3 = document.getElementById('shiba-frame-3');
    const frames = [f1, f2, f3].filter(Boolean) as HTMLElement[];

    function setEyeFrame(idx: number) {
      frames.forEach((f, i) => {
        f.style.opacity = i === idx ? '1' : '0';
      });
    }

    if (frames.length > 1 && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      setInterval(() => {
        // Blink sequence
        setEyeFrame(1);
        setTimeout(() => {
          setEyeFrame(0);
        }, 220);
      }, 3500);

      const mascotSvg = document.getElementById('shiba-header-mascot');
      if (mascotSvg) {
        mascotSvg.addEventListener('mouseenter', () => {
          setEyeFrame(2); // Wink with blush
        });
        mascotSvg.addEventListener('mouseleave', () => {
          setEyeFrame(0);
        });
      }
    }

    // 2. Interactive Review approvals
    document.querySelectorAll('.resolve-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLElement;
        target.textContent = '✓ Approved';
        target.classList.remove('text-teal-300', 'border-teal-500/40');
        target.classList.add('text-emerald-400', 'border-emerald-500/40', 'bg-emerald-500/10');
      });
    });

    // 3. Replay button interaction in hero demo
    const replayBtn = document.getElementById('hero-replay-btn');
    const demoConsole = document.getElementById('demo-step-display');
    if (replayBtn && demoConsole) {
      replayBtn.addEventListener('click', () => {
        replayBtn.innerHTML = '<span>⚡ Running...</span>';
        demoConsole.style.opacity = '0.4';
        demoConsole.style.transition = 'opacity 0.3s ease';
        setTimeout(() => {
          demoConsole.style.opacity = '1';
          replayBtn.innerHTML = '<span class="text-emerald-400">✓ Replayed</span>';
          setTimeout(() => {
            replayBtn.innerHTML = '<svg fill="none" height="12" viewBox="0 0 14 14" width="12" xmlns="http://www.w3.org/2000/svg" class="size-3 text-teal-400"><path d="M2.5 7C2.5 9.48528 4.51472 11.5 7 11.5C9.48528 11.5 11.5 9.48528 11.5 7C11.5 4.51472 9.48528 2.5 7 2.5C5.40879 2.5 4.00852 3.32376 3.19629 4.5625" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path><path d="M3 2V4.75H5.75" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path></svg><span>Replay Run</span>';
          }, 1500);
        }, 700);
      });
    }

    // 4. Multi-agent interactive tab switcher
    const tabAll = document.getElementById('tab-all');
    const tabCaptain = document.getElementById('tab-captain');
    const tabBuild = document.getElementById('tab-build');
    const tabReview = document.getElementById('tab-review');
    const tabTerminal = document.getElementById('tab-terminal');
    const tabs = [tabAll, tabCaptain, tabBuild, tabReview, tabTerminal].filter(Boolean) as HTMLElement[];

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        tabs.forEach(t => {
          t.classList.remove('bg-teal-400/20', 'text-teal-300', 'border-teal-400/40', 'font-bold');
          t.classList.add('text-neutral-400', 'border-transparent');
        });
        tab.classList.remove('text-neutral-400', 'border-transparent');
        tab.classList.add('bg-teal-400/20', 'text-teal-300', 'border-teal-400/40', 'font-bold');
        tabs.forEach(t => t.setAttribute('aria-pressed', String(t === tab)));
        const selected = tab.id.replace('tab-', '');
        document.querySelectorAll<HTMLElement>('[data-demo-agent]').forEach(panel => {
          panel.hidden = selected === 'all' ? panel.dataset.demoAgent === 'terminal' : panel.dataset.demoAgent !== selected;
        });
      });
    });

    // 5. Use Cases Scroll-Triggered Entrance & Live Simulations
    const useCasesSection = document.getElementById('use-cases');
    const useCasePanels = document.querySelectorAll('.usecase-panel');
    let useCasesAnimated = false;

    if (useCasesSection && useCasePanels.length > 0) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting && !useCasesAnimated) {
            useCasesAnimated = true;
            
            // Staggered reveal for each panel
            useCasePanels.forEach((panel, i) => {
              setTimeout(() => {
                panel.classList.add('is-visible');
              }, i * 75);
            });

            // Card 1: E2E Terminal state simulation
            const e2eLine = document.getElementById('e2e-status-line');
            if (e2eLine) {
              e2eLine.innerHTML = '<span class="w-2 h-2 rounded-full bg-amber-400 animate-ping"></span><span class="text-amber-300">Running 32 test specs in Sandbox...</span>';
              setTimeout(() => {
                e2eLine.innerHTML = '<span class="w-2 h-2 rounded-full bg-emerald-400"></span><span class="text-teal-300 font-bold">✓ 32 test specs completed in 1.4s</span>';
              }, 700);
            }

            // Card 2: Bug triage typing stream simulation
            const typingDots = document.getElementById('triage-typing-dots');
            const replyBox = document.getElementById('triage-reply-box');
            if (typingDots && replyBox) {
              replyBox.style.opacity = '0.3';
              typingDots.classList.remove('hidden');
              typingDots.classList.add('flex');
              setTimeout(() => {
                typingDots.classList.add('hidden');
                typingDots.classList.remove('flex');
                replyBox.style.opacity = '1';
                replyBox.style.transition = 'opacity 0.4s ease';
              }, 600);
            }

            // Card 4: Migration progress bar sweep & number count-up
            const progressBar = document.getElementById('migration-progress-bar');
            const counterText = document.getElementById('migration-counter-text');
            if (progressBar && counterText) {
              setTimeout(() => {
                progressBar.style.width = '85%';
                let count = 0;
                const timer = setInterval(() => {
                  count += 5;
                  if (count > 85) {
                    count = 85;
                    clearInterval(timer);
                  }
                  counterText.textContent = count + ' / 100 modules upgraded';
                }, 40);
              }, 200);
            }
          }
        });
      }, { threshold: 0.12 });

      observer.observe(useCasesSection);
    }

  </script>

