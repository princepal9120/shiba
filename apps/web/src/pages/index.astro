---
import '../styles/tailwind.css';
import '../styles/theme.css';
---
<!DOCTYPE html>
<html lang="en" class="dark scroll-smooth">
<head>
  <meta charset="utf-8" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Shiba - The best AI software engineer</title>
  <!-- AI Coworker - The best AI software engineer -->
  <meta name="description" content="Shiba is the best AI software engineer. Delegate tasks to parallel coding agents that plan, build, and ship — from task to merged PR." />
  <link rel="canonical" href="https://tryshiba.dev/" />
  <link rel="sitemap" href="/sitemap.xml" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Shiba" />
  <meta property="og:url" content="https://tryshiba.dev/" />
  <meta property="og:title" content="Shiba - The best AI software engineer" />
  <meta property="og:description" content="Delegate tasks to parallel coding agents that plan, build, and ship — from task to merged PR." />
  <meta property="og:image" content="https://tryshiba.dev/assets/mascot/pet-logo.png" />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:site" content="@prince_twets" />
  <meta name="twitter:title" content="Shiba - The best AI software engineer" />
  <meta name="twitter:description" content="Delegate tasks to parallel coding agents that plan, build, and ship — from task to merged PR." />
  <meta name="twitter:image" content="https://tryshiba.dev/assets/mascot/pet-logo.png" />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "Shiba",
    url: "https://tryshiba.dev/",
    description: "Open-source, self-hosted AI software engineer: approval-gated coding tasks run in isolated Cloudflare Sandbox containers, from task to merged PR.",
    applicationCategory: "DeveloperApplication",
    operatingSystem: "Web",
    license: "https://opensource.org/licenses/MIT",
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
    sameAs: ["https://github.com/princepal9120/shiba", "https://x.com/prince_twets"],
  })} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bangers&family=Bebas+Neue&family=DM+Mono:ital,wght@0,400;0,500;1,400&family=Inter:wght@400;500;600;700;800;900&family=Geist+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
  
  <style is:global>
    :root {
      --color-black: #000000;
      --color-white: #ffffff;
      --color-teal-200: #abe4de;
      --color-teal-300: #63c8c1;
      --color-teal-400: #4db4b0;
      --color-teal-500: #339997;
      --color-teal-600: #267b7a;
      --color-primary: var(--color-teal-300);
      --color-primary-dark: var(--color-teal-600);
      --color-grass-green-400: #96c95f;
      --color-yuzu-yellow-400: #ebc04b;
      --color-orange-red: #ff4512;
      --color-pelican-orange-500: #ef722a;
      --color-galaxy-purple-500: #ae69b1;
      --color-header-height: 4.25rem;
    }

    body {
      background-color: #000000 !important;
      color: #f3f4f6 !important;
      font-family: 'Inter', system-ui, -apple-system, sans-serif;
      margin: 0;
      padding: 0;
      overflow-x: hidden;
    }

    .font-heading, .font-display {
      font-family: 'Bebas Neue', Impact, sans-serif !important;
      letter-spacing: 0.03em;
    }

    .font-manga, .font-comic {
      font-family: 'Bangers', 'Comic Sans MS', cursive, sans-serif !important;
      letter-spacing: 0.05em;
    }

    .font-dm-mono, .font-tech {
      font-family: 'DM Mono', 'Geist Mono', monospace !important;
    }

    /* Manga Pattern Backgrounds */
    .grid-bg {
      background-size: 32px 32px;
      background-image: linear-gradient(to right, rgba(255, 255, 255, 0.04) 1px, transparent 1px),
                        linear-gradient(to bottom, rgba(255, 255, 255, 0.04) 1px, transparent 1px);
    }

    .manga-brick-bg {
      background-image: url('/assets/theme/sidebar-bg-tile-brick.svg');
      background-size: 2.4rem auto;
      background-repeat: repeat;
    }

    .manga-tile-bg {
      background-image: url('/assets/theme/sidebar-bg-tile.svg');
      background-size: 2.4rem;
      background-repeat: repeat;
    }

    /* Neo-Brutalist Manga Buttons */
    .manga-btn-primary {
      background-color: var(--color-teal-300);
      color: #000000;
      font-weight: 700;
      border: 1.5px solid var(--color-primary-dark);
      box-shadow: -3px 3px 0 0 var(--color-primary-dark);
      transition: all 0.15s ease-out;
    }
    .manga-btn-primary:hover {
      transform: translate(2px, -2px);
      box-shadow: 0 0 0 0 var(--color-primary-dark);
      background-color: #72d6cf;
    }

    .manga-btn-secondary {
      background-color: #111317;
      color: #ffffff;
      font-weight: 600;
      border: 1.5px solid #333842;
      box-shadow: -3px 3px 0 0 #000000;
      transition: all 0.15s ease-out;
    }
    .manga-btn-secondary:hover {
      transform: translate(2px, -2px);
      box-shadow: 0 0 0 0 #000000;
      border-color: var(--color-teal-400);
      color: var(--color-teal-300);
    }

    /* Manga Comic Panel Frames */
    .manga-panel {
      border: 2px solid #22262e;
      background-color: #090a0d;
      position: relative;
      transition: border-color 0.2s ease, transform 0.2s ease;
    }
    .manga-panel:hover {
      border-color: #404856;
    }

    /* Infinite Marquee */
    @keyframes mangaMarquee {
      0% { transform: translateX(0%); }
      100% { transform: translateX(-50%); }
    }
    .manga-marquee {
      display: flex;
      width: max-content;
      animation: mangaMarquee 30s linear infinite;
    }
    .manga-marquee:hover {
      animation-play-state: paused;
    }

    /* Diff styling */
    .diff-line-add {
      background-color: rgba(99, 200, 193, 0.15);
      color: #63c8c1;
      border-left: 2px solid #4db4b0;
    }
    
    /* Mascot Character Animations */
    @keyframes mascot-float {
      0%, 100% { transform: translateY(0px) rotate(0deg); }
      50% { transform: translateY(-8px) rotate(-2deg); }
    }
    @keyframes mascot-bounce {
      0%, 100% { transform: translateY(0); }
      40% { transform: translateY(-10px); }
      60% { transform: translateY(-3px); }
    }
    @keyframes mascot-breathe {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.05); }
    }
    @keyframes mascot-sway {
      0%, 100% { transform: rotate(-4deg); }
      50% { transform: rotate(4deg); }
    }
    .mascot-floating {
      animation: mascot-float 3.5s ease-in-out infinite;
    }
    .mascot-bouncing {
      animation: mascot-bounce 2.2s ease infinite;
    }
    .mascot-breathing {
      animation: mascot-breathe 2.8s ease-in-out infinite;
      transform-origin: bottom center;
    }
    .mascot-swaying {
      animation: mascot-sway 3s ease-in-out infinite;
    }

    
    /* Global Mascot Eye Blinking Animation Cycle */
    @keyframes animShadesGlobal {
      0%, 72% { opacity: 1; visibility: visible; }
      73%, 98% { opacity: 0; visibility: hidden; }
      99%, 100% { opacity: 1; visibility: visible; }
    }
    @keyframes animSquintGlobal {
      0%, 72% { opacity: 0; visibility: hidden; }
      73%, 85% { opacity: 1; visibility: visible; }
      86%, 100% { opacity: 0; visibility: hidden; }
    }
    @keyframes animWinkGlobal {
      0%, 85% { opacity: 0; visibility: hidden; }
      86%, 98% { opacity: 1; visibility: visible; }
      99%, 100% { opacity: 0; visibility: hidden; }
    }
    #shiba-frame-1, .shiba-frame-1 {
      animation: animShadesGlobal 3.8s cubic-bezier(0.4, 0, 0.2, 1) infinite !important;
    }
    #shiba-frame-2, .shiba-frame-2 {
      animation: animSquintGlobal 3.8s cubic-bezier(0.4, 0, 0.2, 1) infinite !important;
    }
    #shiba-frame-3, .shiba-frame-3 {
      animation: animWinkGlobal 3.8s cubic-bezier(0.4, 0, 0.2, 1) infinite !important;
    }

    .diff-line-del {
      background-color: rgba(255, 69, 18, 0.15);
      color: #ff6842;
      border-left: 2px solid #ff4512;
    }

    [hidden] { display: none !important; }
    :is(a, button):focus-visible { outline: 2px solid #63c8c1; outline-offset: 4px; }
    main section { scroll-margin-top: 9rem; }
    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto !important; }
      *, *::before, *::after { animation: none !important; transition: none !important; }
      .shiba-frame-2, .shiba-frame-3 { visibility: hidden !important; }
    }

    .agent-tab {
      flex-shrink: 0;
      white-space: nowrap;
      min-height: 44px;
    }

    #demo-step-display > div > .w-full {
      min-width: 0;
    }

    @media (max-width: 639px) {
      header nav { gap: 0 1rem; }
      header nav a, footer nav a {
        display: inline-flex;
        align-items: center;
        min-height: 44px;
      }
      #hero-replay-btn, .resolve-btn { min-height: 44px; }
      #demo-step-display > div:first-child,
      #demo-step-display > div > .w-full > div:first-child {
        flex-direction: column;
        align-items: flex-start;
        gap: 0.5rem;
      }
      #demo-step-display > div > .w-full > div:first-child > div {
        flex-wrap: wrap;
      }
      #demo-step-display > div:not(:first-child) {
        flex-direction: column;
      }
      #demo-step-display .diff-line-add,
      #demo-step-display .diff-line-del { overflow-wrap: anywhere; }
      #demo-console-body > div:last-child > div:first-child {
        flex-wrap: wrap;
        gap: 0.5rem;
      }
      #pricing .manga-panel:first-child > .absolute {
        position: static;
        margin-bottom: 1rem;
      }
    }
  </style>
</head>
<body class="antialiased selection:bg-[#63c8c1] selection:text-black grid-bg">

  <!-- HEADER -->
  <header class="sticky top-0 z-50 w-full border-b border-neutral-800/80 bg-black/95 backdrop-blur-md relative after:pointer-events-none after:absolute after:inset-0 after:-z-10 after:manga-brick-bg after:opacity-10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-3">
      
      <!-- LOGO & BRAND -->
      <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
        <a href="/" class="flex items-center gap-3 group shrink-0">
          <!-- Shiba Mascot Pet Logo -->
          <div class="relative w-10 h-10 flex items-center justify-center shrink-0">
            <img src="/assets/mascot/pet-logo.png" alt="Shiba Mascot" class="w-10 h-10 rounded-full bg-white object-contain border border-teal-500/50 shadow-sm cursor-pointer transition-transform group-hover:scale-105" />
          </div>

          <div class="flex flex-col text-left whitespace-nowrap">
            <div class="flex items-center gap-2">
              <span class="font-heading text-2xl tracking-wider text-white leading-none">SHIBA</span>
            </div>
            <span class="font-dm-mono text-[10px] text-neutral-400 tracking-wider whitespace-nowrap">THE BEST AI SOFTWARE ENGINEER</span>
          </div>
        </a>

        <nav aria-label="Main navigation" class="flex flex-wrap items-center justify-center gap-x-5 gap-y-3 font-dm-mono text-[13px] tracking-wide whitespace-nowrap">
          <a href="/app/" class="text-teal-300 hover:text-white transition-colors font-semibold flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-teal-400 animate-pulse"></span>Dashboard</a>
          <a href="/docs/overview" class="text-neutral-300 hover:text-white transition-colors">Docs</a>
          <a href="/docs/slack" class="text-neutral-300 hover:text-white transition-colors">Integrations</a>
          <a href="/docs/claude-code" class="text-neutral-300 hover:text-white transition-colors">Agents</a>
          <a href="/docs/deployment" class="text-neutral-300 hover:text-white transition-colors">Deployment</a>
        </nav>
      </div>
    </div>
  </header>

  <main>
    <!-- HERO SECTION -->
    <section class="relative isolate pt-6 sm:pt-10 pb-16 overflow-hidden text-center">
      <!-- Dark overlay keeps text readable over the daylight sky. -->
      <div class="absolute inset-0 -z-10 bg-cover bg-center bg-no-repeat" style="background-image: url('/assets/synara/hero-bg.jpg');" aria-hidden="true"></div>
      <div class="absolute inset-0 -z-10 bg-gradient-to-b from-black/85 via-black/75 to-black" aria-hidden="true"></div>
      <div class="max-w-6xl mx-auto px-4 sm:px-6">
        
        <!-- MAIN HEADLINE -->
        <h1 class="font-heading text-6xl sm:text-7xl md:text-8xl lg:text-[7.5rem] tracking-tight uppercase text-white leading-[0.88] max-w-5xl mx-auto mb-6">
          <span class="block text-teal-400">THE BEST SELF-HOSTED</span>
          <span class="block text-white">AI SOFTWARE ENGINEER</span>
        </h1>

        <!-- SUBTITLE -->
        <p class="font-dm-mono text-base sm:text-lg md:text-xl text-neutral-400 max-w-2xl mx-auto mb-8 leading-relaxed">
          Orchestrate a fleet of cloud coding agents in all of the apps your team already lives in.
        </p>

        <!-- CTAS -->
        <div class="flex flex-wrap items-center justify-center gap-4 mb-14">
          <a href="/app/" class="manga-btn-primary px-7 py-3 rounded-lg font-heading text-2xl tracking-wider uppercase inline-flex items-center gap-2.5">
            <span>Open Dashboard 🚀</span>
          </a>
          <a href="/docs/getting-started" class="manga-btn-secondary px-6 py-3 rounded-lg font-dm-mono text-sm tracking-wide inline-flex items-center gap-2 hover:border-teal-400">
            <span>Docs & Guide</span>
          </a>
          <a href="https://github.com/princepal9120/shiba" target="_blank" rel="noopener noreferrer" class="manga-btn-secondary px-6 py-3 rounded-lg font-dm-mono text-sm tracking-wide inline-flex items-center gap-2 hover:border-teal-400">
            <span>Star on GitHub</span>
            <span class="text-teal-400">★</span>
          </a>
        </div>

        <!-- HERO INTERACTIVE MULTI-AGENT WORKSPACE -->
        <div class="relative max-w-5xl mx-auto text-left">
          
          <!-- Atmospheric Glow -->
          <div class="absolute -inset-2 bg-gradient-to-b from-teal-500/15 via-transparent to-transparent rounded-2xl filter blur-xl -z-10 opacity-80"></div>

          <!-- IDE Manga Window Container -->
          <div class="manga-panel rounded-xl overflow-hidden shadow-2xl border-2 border-neutral-700/90 bg-[#090a0d] relative">
            
            <!-- Top IDE Titlebar with Manga Details -->
            <div class="bg-[#12141a] px-4 py-3 border-b border-neutral-800 flex items-center justify-between flex-wrap gap-3">
              <div class="flex items-center gap-2.5">
                <span class="w-3 h-3 rounded-full bg-red-500/80 inline-block"></span>
                <span class="w-3 h-3 rounded-full bg-yellow-500/80 inline-block"></span>
                <span class="w-3 h-3 rounded-full bg-emerald-500/80 inline-block"></span>
                <span class="ml-2 font-dm-mono text-xs text-neutral-400 font-semibold tracking-wide flex items-center gap-2">
                  <span class="text-teal-300">shiba-orchestrator</span>
                  <span class="text-neutral-600">/</span>
                  <span>task-SCO-15215</span>
                </span>
              </div>

              <!-- Replay & Live Status Controls -->
              <div class="flex items-center gap-3">
                <div class="flex items-center gap-2 px-2.5 py-1 rounded-lg bg-black/60 border border-neutral-800 font-dm-mono text-[11px] text-neutral-300 shadow-sm">
                  <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                  <span>Example workflow</span>
                </div>
                <button id="hero-replay-btn" class="manga-btn-secondary px-3 py-1.5 rounded-lg text-xs font-dm-mono flex items-center gap-1.5 hover:border-teal-400 cursor-pointer shadow-sm">
                  <svg fill="none" height="12" viewBox="0 0 14 14" width="12" xmlns="http://www.w3.org/2000/svg" class="size-3 text-teal-400">
                    <path d="M2.5 7C2.5 9.48528 4.51472 11.5 7 11.5C9.48528 11.5 11.5 9.48528 11.5 7C11.5 4.51472 9.48528 2.5 7 2.5C5.40879 2.5 4.00852 3.32376 3.19629 4.5625" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path>
                    <path d="M3 2V4.75H5.75" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path>
                  </svg>
                  <span>Replay Run</span>
                </button>
              </div>
            </div>

            <!-- Agent Role Switcher Tabs with Real Mascot Avatars -->
            <div class="bg-[#0b0d11] px-4 py-2 border-b border-neutral-800 flex items-center gap-2 overflow-x-auto">
              <button id="tab-all" aria-pressed="true" aria-controls="demo-step-display" class="agent-tab px-3 py-1.5 rounded-md font-dm-mono text-xs font-bold bg-teal-400/20 text-teal-300 border border-teal-400/40 flex items-center gap-2 transition-all">
                <img src="/assets/theme/circle_shiba.svg" alt="Pipeline" class="w-3.5 h-3.5 rounded-full" />
                <span>Pipeline View</span>
              </button>
              <button id="tab-captain" aria-pressed="false" aria-controls="demo-step-display" class="agent-tab px-3 py-1.5 rounded-md font-dm-mono text-xs font-semibold text-neutral-400 hover:text-white border border-transparent hover:border-neutral-800 flex items-center gap-2 transition-all">
                <img src="/assets/mascot/shiba-sticker-sunglasses.webp" alt="Captain" class="w-3.5 h-3.5 rounded-full object-cover" />
                <span>Captain (Planner)</span>
              </button>
              <button id="tab-build" aria-pressed="false" aria-controls="demo-step-display" class="agent-tab px-3 py-1.5 rounded-md font-dm-mono text-xs font-semibold text-neutral-400 hover:text-white border border-transparent hover:border-neutral-800 flex items-center gap-2 transition-all">
                <img src="/assets/mascot/shiba-sticker-climbing.webp" alt="Build Agent" class="w-3.5 h-3.5 rounded-full object-cover" />
                <span>Build Agent (Sandbox)</span>
              </button>
              <button id="tab-review" aria-pressed="false" aria-controls="demo-step-display" class="agent-tab px-3 py-1.5 rounded-md font-dm-mono text-xs font-semibold text-neutral-400 hover:text-white border border-transparent hover:border-neutral-800 flex items-center gap-2 transition-all">
                <img src="/assets/mascot/shiba-logo-animated.svg" alt="Review Agent" class="w-3.5 h-3.5 rounded-full" />
                <span>Review Agent (QA)</span>
              </button>
              <button id="tab-terminal" aria-pressed="false" aria-controls="demo-step-display" class="agent-tab px-3 py-1.5 rounded-md font-dm-mono text-xs font-semibold text-neutral-400 hover:text-white border border-transparent hover:border-neutral-800 flex items-center gap-2 transition-all">
                <span class="text-teal-400">>_</span>
                <span>Terminal Log</span>
              </button>
            </div>

            <!-- Live Workspace Content Body -->
            <div id="demo-console-body" class="p-4 sm:p-6 font-dm-mono text-xs sm:text-sm bg-[#07080b] min-h-[340px] flex flex-col justify-between">
              
              <div id="demo-step-display" class="space-y-3">
                <div class="text-neutral-500 font-bold uppercase tracking-wider text-[10px] mb-2 flex items-center justify-between">
                  <span>ORCHESTRATION PIPELINE · TASK: FIX SIGN-UP FORM DATA & APPROVAL GATES</span>
                  <span class="text-teal-400 font-bold">ILLUSTRATIVE RUN · SAMPLE DATA</span>
                </div>

                <!-- Captain Card (Manga Illustrated Avatar Badge) -->
                <div data-demo-agent="captain" class="bg-[#101217] p-3.5 sm:p-4 rounded-xl border-2 border-neutral-800/80 hover:border-teal-500/40 transition-colors flex items-start gap-3.5 shadow-sm">
                  <!-- Circular Inked Avatar Badge like Image #1 -->
                  <div class="relative w-11 h-11 rounded-full border-2 border-black overflow-hidden shrink-0 shadow-[0_2px_8px_rgba(0,0,0,0.8)] bg-[#0B9F95]">
                    <img src="/assets/mascot/shiba-sticker-sunglasses.webp" alt="Captain Planner" class="w-full h-full object-cover" />
                    <span class="absolute bottom-0 right-0 bg-yellow-400 text-black text-[9px] font-black px-1 rounded-full border border-black leading-none">⚡</span>
                  </div>

                  <div class="space-y-1.5 w-full">
                    <div class="flex items-center justify-between">
                      <div class="flex items-center gap-2">
                        <span class="font-bold text-white text-xs sm:text-sm">Captain: Spec & Parallel Delegation</span>
                        <span class="px-1.5 py-0.2 rounded text-[9px] font-bold uppercase bg-teal-500/20 text-teal-300 border border-teal-500/40">Planning Active</span>
                      </div>
                      <span class="text-[10px] text-neutral-500">00:00.12</span>
                    </div>
                    <p class="text-neutral-300 text-xs leading-relaxed">
                      Deconstructed issue <span class="text-teal-300 font-semibold">#15215</span>: Booting isolated Sandbox microVM, applying patch to <code class="text-neutral-200 bg-black/60 px-1 py-0.5 rounded border border-neutral-800">src/auth/handler.ts</code>, delegating regression test sweep to Build Agent.
                    </p>
                  </div>
                </div>

                <!-- Build Agent Card (Manga Illustrated Avatar Badge) -->
                <div data-demo-agent="build" class="bg-[#101217] p-3.5 sm:p-4 rounded-xl border-2 border-neutral-800/80 hover:border-cyan-500/40 transition-colors flex items-start gap-3.5 shadow-sm">
                  <!-- Circular Inked Avatar Badge like Image #1 -->
                  <div class="relative w-11 h-11 rounded-full border-2 border-black overflow-hidden shrink-0 shadow-[0_2px_8px_rgba(0,0,0,0.8)] bg-[#0891b2]">
                    <img src="/assets/mascot/shiba-sticker-climbing.webp" alt="Build Agent Sandbox" class="w-full h-full object-cover" />
                    <span class="absolute bottom-0 right-0 bg-cyan-400 text-black text-[9px] font-black px-1 rounded-full border border-black leading-none">🔨</span>
                  </div>

                  <div class="space-y-1.5 w-full">
                    <div class="flex items-center justify-between">
                      <div class="flex items-center gap-2">
                        <span class="font-bold text-white text-xs sm:text-sm">Build Agent: Cloudflare Sandbox MicroVM</span>
                        <span class="px-1.5 py-0.2 rounded text-[9px] font-bold uppercase bg-cyan-500/20 text-cyan-300 border border-cyan-500/40">standard-1 VM</span>
                      </div>
                      <span class="text-[10px] text-teal-400 font-bold">Booted in 340ms</span>
                    </div>
                    
                    <div class="text-neutral-300 text-xs space-y-1 font-dm-mono bg-black/80 p-3 rounded-lg border border-neutral-800/90 shadow-inner">
                      <div class="diff-line-del px-2 py-0.5">- const user = await db.query('SELECT * FROM users WHERE id = ?', [rawId]);</div>
