---
import MarketingPage from '../layouts/MarketingPage.astro';

const description = 'A self-hosted AI engineer that asks before it writes code. Runs in your Cloudflare account, on Claude Code, Codex, OpenCode, or Devin.';
const schema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Shiba',
  url: 'https://tryshiba.dev/',
  description,
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Web',
  license: 'https://spdx.org/licenses/AGPL-3.0-only.html',
  sameAs: ['https://github.com/princepal9120/shiba'],
};

// The switch reasons, stated as flat claims. Adjectives are deliberately
// absent — each row names a concrete thing the buyer either gets or does not.
const comparisons = [
  { point: 'Runs in infrastructure you own', shiba: 'Your Cloudflare account', them: "The provider's account" },
  { point: 'Model and harness per run', shiba: 'Claude Code, Codex, OpenCode, Devin', them: 'Chosen by the provider' },
  { point: 'Approval before code runs', shiba: 'Required by default', them: 'Varies by product' },
  { point: 'Who holds the credentials', shiba: 'You do, at egress', them: 'Held by the provider' },
  { point: 'License', shiba: 'AGPL-3.0, source readable', them: 'Proprietary' },
];

const capabilities = [
  { number: '01', symbol: '▣', title: 'Approval before execution', detail: 'Review the exact repository, branch, task, and requested output. By default, no sandbox starts until you approve.' },
  { number: '02', symbol: '▧', title: 'An isolated workspace', detail: 'Each approved task runs in its own Cloudflare Sandbox container, separate from your Worker and other runs.' },
  { number: '03', symbol: '◫', title: 'Work you can inspect', detail: 'Follow agent progress, changed files, and a unified diff in the dashboard before deciding what to do next.' },
  { number: '04', symbol: '⌁', title: 'Your account, your controls', detail: 'Self-host the Worker, choose your model route, and keep provider credentials outside the container.' },
  { number: '05', symbol: '↗', title: 'Optional pull requests', detail: 'Ask Shiba to open a branch and pull request when you configure a GitHub token; diff-only tasks need no token.' },
  { number: '06', symbol: '≋', title: 'Chat and dashboard entry points', detail: 'Start and review tasks from the dashboard, Slack, Telegram, Discord, or the mobile web app. A native iPhone app is on the roadmap.' },
];
---

<MarketingPage title="Shiba - Your AI software engineer" description={description} path="/" schema={schema}>
  <section class="shell home-hero" aria-labelledby="home-title">
    <div class="hero-copy">
      <p class="eyebrow">OPEN-SOURCE DEVIN CLOUD ALTERNATIVE</p>
      <h1 id="home-title">It asks before<br /><em>it writes code.</em></h1>
      <p class="hero-lead">Give Shiba a repository and a task. When deployed, review the exact plan before a sandbox starts by default, then follow the work in your Cloudflare account.</p>
      <div class="hero-actions">
        <a class="button" href="https://github.com/princepal9120/shiba">Join the build <span aria-hidden="true">↗</span></a>
        <a class="button button-outline" href="/docs/getting-started/">Read the docs</a>
      </div>
		<p class="hero-note">No hosted black box. Every task is approval-gated before a sandbox starts.</p>
    </div>

    <figure class="hero-showcase" aria-label="Illustration of shiba.workspace">
      <img
        id="hero-showcase-img"
        class="hero-showcase-img"
        src="/assets/shiba-hero-window-dark.png"
        alt="Retro desktop window of the shiba.workspace: harness chips, a pixel workstation, capability icons, and a status bar reading your Cloudflare account, one approval, four harnesses"
        width="1266"
        height="878"
        loading="eager"
        fetchpriority="high"
      />
    </figure>
    <script is:inline>
      (function() {
        var img = document.getElementById('hero-showcase-img');
        if (!img) return;
        function update() {
          var dark = document.documentElement.getAttribute('data-theme') === 'dark';
          img.src = dark ? '/assets/shiba-hero-window-dark.png' : '/assets/shiba-hero-window.png';
        }
        update();
        var obs = new MutationObserver(update);
        obs.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
      })();
    </script>
  </section>

  <div class="shell compatibility" aria-label="Ways to use Shiba"><span>USE FROM</span><span>Web</span><span>Slack</span><span>Telegram</span><span>Discord</span><span>GitHub</span><span class="compatibility-end">Mobile web is available; native iPhone app is on the roadmap.</span></div>

  <section id="harnesses" class="shell harness-section" aria-labelledby="harness-title">
    <p class="eyebrow">TOOLS &amp; MODEL PROVIDERS</p>
    <h2 id="harness-title">Bring your tools. Keep control.</h2>
    <p class="harness-lead">All four harnesses are supported — pick OpenCode, Claude Code, Codex, or Devin CLI, and run them with your own provider credentials. Other logos are shown for reference—not as claims of a Shiba integration.</p>
    <div class="harness-grid" role="list" aria-label="Coding tools and model providers">
      <div class="harness-item integrated" role="listitem"><span class="harness-icon"><img src="/assets/harnesses/opencode.svg" alt="" width="32" height="32" /></span><span class="harness-label">OpenCode<small>INTEGRATED</small></span></div>
      <div class="harness-item integrated" role="listitem"><span class="harness-icon"><img src="/assets/harnesses/claude.svg" alt="" width="32" height="32" /></span><span class="harness-label">Claude Code<small>INTEGRATED</small></span></div>
      <div class="harness-item integrated" role="listitem"><span class="harness-icon"><img src="/assets/harnesses/openai.svg" alt="" width="32" height="32" /></span><span class="harness-label">Codex<small>INTEGRATED</small></span></div>
      <div class="harness-item integrated" role="listitem"><span class="harness-icon"><img src="/assets/harnesses/devin.svg" alt="" width="32" height="32" /></span><span class="harness-label">Devin CLI<small>INTEGRATED</small></span></div>
      <div class="harness-item reference" role="listitem"><span class="harness-icon"><img src="/assets/harnesses/cursor.svg" alt="" width="32" height="32" /></span><span class="harness-label">Cursor<small>NOT INTEGRATED</small></span></div>
      <div class="harness-item reference" role="listitem"><span class="harness-icon"><img src="/assets/harnesses/grok.svg" alt="" width="32" height="32" /></span><span class="harness-label">Grok<small>MODEL REFERENCE</small></span></div>
    </div>
    <p class="harness-note">Product names and logos belong to their respective owners. No affiliation is implied. <a href="/docs/claude-code/">See supported configuration →</a></p>
  </section>

  <section id="channels" class="shell home-section channels-section" aria-labelledby="channels-title">
    <div class="section-head">
      <div>
        <p class="eyebrow">TRIGGER FROM ANYWHERE</p>
        <h2 id="channels-title">Trigger @shiba.<br /><em>Get work done from anywhere.</em></h2>
      </div>
      <p class="micro">SLACK · MOBILE WEB · TELEGRAM · DISCORD</p>
    </div>
    <div class="channels-intro">
      <p>Whether you are at your desk, on Slack, or on your phone, trigger <code>@shiba</code> to delegate a task. Review the exact plan, approve with one tap, and follow sandbox progress end-to-end.</p>
    </div>
    <div class="channels-grid">
      <div class="channel-card">
        <div class="channel-top">
          <span class="channel-icon"><img src="/assets/channels/slack.svg" alt="" width="22" height="22" /></span>
          <span class="channel-badge live">● LIVE CHATOPS</span>
        </div>
        <h3>Slack</h3>
        <div class="channel-bubble">
          <span class="bubble-prompt"><strong class="highlight">@shiba</strong> fix the token refresh race in auth.ts</span>
          <span class="bubble-reply">↳ Generated plan ready for review</span>
        </div>
        <p>Trigger in any channel or thread. Approvals arrive as interactive Block Kit cards with diff previews.</p>
      </div>

      <div class="channel-card">
        <div class="channel-top">
          <span class="channel-icon"><img src="/assets/channels/iphone.svg" alt="" width="22" height="22" /></span>
          <span class="channel-badge live">● MOBILE WEB</span>
        </div>
        <h3>Mobile web</h3>
        <div class="channel-bubble">
          <span class="bubble-prompt"><strong class="highlight">Add to Home Screen</strong> · Standalone App</span>
          <span class="bubble-reply">↳ 1-tap review &amp; sandbox approval</span>
        </div>
        <p>Mobile-optimized dashboard. Review proposed tool inputs, follow logs, and inspect diffs from anywhere.</p>
      </div>

      <div class="channel-card">
        <div class="channel-top">
          <span class="channel-icon"><img src="/assets/channels/telegram.svg" alt="" width="22" height="22" /></span>
          <span class="channel-badge live">● LIVE CHATOPS</span>
        </div>
        <h3>Telegram</h3>
        <div class="channel-bubble">
          <span class="bubble-prompt"><strong class="highlight">/shiba</strong> deploy staging hotfix --branch main</span>
          <span class="bubble-reply">↳ Webhook dispatch &amp; inline buttons</span>
        </div>
        <p>Direct bot interaction with cryptographic webhook dispatch and inline button approval gates end-to-end.</p>
      </div>

      <div class="channel-card">
        <div class="channel-top">
          <span class="channel-icon"><img src="/assets/channels/discord.svg" alt="" width="22" height="22" /></span>
          <span class="channel-badge live">● LIVE CHATOPS</span>
        </div>
        <h3>Discord</h3>
        <div class="channel-bubble">
          <span class="bubble-prompt"><strong class="highlight">/shiba</strong> task repo:backend issue:#142</span>
          <span class="bubble-reply">↳ Threaded run logs &amp; diff previews</span>
        </div>
        <p>Slash commands and bot mentions for developer servers, with threaded progress updates and sandbox review.</p>
      </div>
    </div>
  </section>

  <section class="shell home-section" aria-labelledby="why-title">
    <div class="section-head"><h2 id="why-title">The agent does the work.<br /><em>You keep the keys.</em></h2><p class="micro">ONE DEPLOYMENT · ONE CONTROL PLANE</p></div>
    <div class="section-copy"><p>An AI coding tool is worth exactly as much as the boundary around it. Shiba runs in your Cloudflare account, requires human approval before sandbox execution by default, and shows resulting changes instead of asking you to take completion on faith.</p><a class="text-link" href="/why-shiba/">Why we built it <span aria-hidden="true">↗</span></a></div>
  </section>

  <section class="shell home-section compare" aria-labelledby="compare-title">
    <div class="section-head"><h2 id="compare-title">Why switch off a hosted agent.</h2><p class="micro">SHIBA VS A MANAGED CLOUD AGENT</p></div>
    <div class="compare-grid" role="table" aria-label="Shiba compared with a managed cloud coding agent">
      <div class="compare-row compare-head" role="row">
        <span role="columnheader"></span>
        <span role="columnheader" class="compare-shiba"><span class="compare-col-label">Shiba</span><span class="compare-col-full">SHIBA</span></span>
        <span role="columnheader"><span class="compare-col-label">Managed cloud agent</span><span class="compare-col-full">MANAGED CLOUD AGENT</span></span>
      </div>
      {comparisons.map((row) => (
        <div class="compare-row" role="row">
          <span role="cell">{row.point}</span>
          <span role="cell" class="compare-shiba"><span class="compare-col-label">Shiba</span><span class="compare-col-full">{row.shiba}</span></span>
          <span role="cell"><span class="compare-col-label">Managed cloud agent</span><span class="compare-col-full">{row.them}</span></span>
        </div>
      ))}
    </div>
  </section>

  <section class="shell home-section capabilities" aria-labelledby="capabilities-title">
    <div class="section-head"><h2 id="capabilities-title">What Shiba gives you</h2><p class="micro">SIX PRACTICAL CAPABILITIES</p></div>
    <div class="capability-grid">
      {capabilities.map((item) => <article class="capability-card"><div class="capability-top"><span class="capability-icon" aria-hidden="true">{item.symbol}</span><span class="micro">{item.number}</span></div><h3>{item.title}</h3><p>{item.detail}</p></article>)}
    </div>
  </section>

  <section class="shell home-section steps" aria-labelledby="steps-title">
    <div class="section-head"><h2 id="steps-title">From task to inspectable diff</h2><p class="micro">THE APPROVAL GATE IS THE WORKFLOW</p></div>
    <div class="steps-grid">
      <div class="step-card">
        <div class="step-dither-screen" aria-hidden="true">
          <div class="step-illustration"><img class="dithered-light" src="/assets/shiba-card-01-repo.png" alt="" width="1672" height="941" loading="lazy" /><img class="dithered-dark" src="/assets/shiba-card-01-repo-dark.png" alt="" width="1672" height="941" loading="lazy" aria-hidden="true" /></div>
        </div>
        <span class="micro">01 / CONNECT</span>
        <h3>Bring a repository</h3>
        <p>Paste an HTTPS GitHub repository URL and describe the coding task in the dashboard.</p>
      </div>

      <div class="step-card">
        <div class="step-dither-screen" aria-hidden="true">
          <div class="step-illustration"><img class="dithered-light" src="/assets/shiba-card-02-approval.png" alt="" width="1672" height="941" loading="lazy" /><img class="dithered-dark" src="/assets/shiba-card-02-approval-dark.png" alt="" width="1672" height="941" loading="lazy" aria-hidden="true" /></div>
        </div>
        <span class="micro">02 / DECIDE</span>
        <h3>Approve or reject</h3>
        <p>Inspect the proposed tool input. By default, Shiba waits for your approval before starting a sandbox.</p>
      </div>

      <div class="step-card">
        <div class="step-dither-screen" aria-hidden="true">
          <div class="step-illustration"><img class="dithered-light" src="/assets/shiba-card-03-diff.png" alt="" width="1672" height="941" loading="lazy" /><img class="dithered-dark" src="/assets/shiba-card-03-diff-dark.png" alt="" width="1672" height="941" loading="lazy" aria-hidden="true" /></div>
        </div>
        <span class="micro">03 / REVIEW</span>
        <h3>See what changed</h3>
        <p>Follow progress and review changed files and the diff. Publishing a pull request is optional.</p>
      </div>
    </div>
  </section>

  <section class="shell closing" aria-labelledby="closing-title"><div><p class="eyebrow">BUILD WITH YOUR OWN AGENT</p><h2 id="closing-title">Put software engineer in your cloud.</h2><p>Open source (AGPL-3.0), self-hosted, and yours to fork. It takes one command to run it against a repo you own.</p></div><div class="closing-actions"><a class="button" href="/docs/getting-started/">Run it on your repo <span aria-hidden="true">↗</span></a></div></section>
</MarketingPage>

<style>
  /* Hero rhythm — 4-unit base. The label belongs to the headline (tight), the
     headline-to-lead break is the section's main pause, then intervals tighten
     toward the quiet note so the column tapers instead of repeating one value. */
  .home-hero { display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1.3fr); gap:clamp(28px, 4vw, 48px); align-items:start; padding-block:36px 18px; --hero-gap-tight:14px; --hero-gap-lg:24px; --hero-gap-md:20px; --hero-gap-sm:14px; }
  .hero-copy { animation:hero-arrive 560ms cubic-bezier(.2,.7,.2,1) both; }
  /* Size the headline to the measure it actually has, not to the viewport.
     10.9cqi keeps "Your AI software engineer." on one line at every column
     width; balance is the backstop when webfont metrics fall back. */
  .hero-copy { container-type:inline-size; }
  .hero-copy h1 { max-width:none; margin:var(--hero-gap-tight) 0 var(--hero-gap-lg); font-size:clamp(32px,10.9cqi,84px); line-height:1.03; text-wrap:balance; }
  .hero-copy h1 em, .home-section h2 em { color:var(--navy); font-weight:400; }
  .hero-lead { max-width:46ch; font-size:16px; line-height:1.65; text-wrap:pretty; }
  .hero-actions, .closing-actions { display:flex; flex-wrap:wrap; align-items:center; gap:12px; margin-top:28px; }
  .home-hero .hero-actions { margin-top:var(--hero-gap-md); }
  .hero-note { display:flex; align-items:flex-start; gap:8px; margin-top:var(--hero-gap-sm); font:10px 'Geist Mono',monospace; letter-spacing:.02em; }
  .hero-note::before { content:''; flex:none; width:6px; height:6px; margin-top:4px; background:var(--navy); }
  .hero-showcase { border:1px solid var(--line-2); background:var(--panel-2); padding:4px; box-shadow:6px 6px 0 var(--paper-shadow); transition:transform 220ms ease, box-shadow 220ms ease; animation:hero-arrive 680ms 100ms cubic-bezier(.2,.7,.2,1) both; margin:0; }
  .hero-showcase:hover, .hero-showcase:focus-within { transform:translateY(-2px); box-shadow:8px 8px 0 var(--paper-shadow); }
  .hero-showcase-img { display:block; width:100%; height:auto; image-rendering:pixelated; border:1px solid var(--line-2); }
  @media (max-width:900px) {
    .home-hero { grid-template-columns:1fr; }
    .hero-showcase { width:100%; }
  }
  @keyframes approval-pulse { 0%, 100% { opacity:1; } 50% { opacity:.58; } }
  @keyframes hero-arrive { from { opacity:0; translate:0 14px; } to { opacity:1; translate:0 0; } }
  @media (prefers-reduced-motion: reduce) {
    .hero-copy, .hero-showcase { animation:none; }
    .hero-showcase { transition:none; }
    .step-dither-screen { transition:none; }
    .step-card:hover .step-dither-screen { transform:none; }
  }
  .compatibility { display:flex; flex-wrap:wrap; align-items:center; gap:14px 24px; padding-block:14px; border-top:1px solid var(--line-2); border-bottom:1px solid var(--line-2); font:11px 'Geist Mono',monospace; color:var(--ink); }
  .compatibility>span:first-child { font-size:9px; letter-spacing:.15em; color:var(--ink-2); margin-right:auto; }
  .compatibility-end { margin-left:auto; color:var(--ink-2); font-size:9px; }
  .harness-section { padding-top:85px; text-align:center; }
  .harness-section h2 { margin:12px 0 14px; }
  .harness-lead { max-width:690px; margin:0 auto 30px; font-size:14px; line-height:1.7; }
  .harness-grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    border: 1px solid var(--line-2);
    background: var(--line-2);
    gap: 1px;
    box-shadow: 3px 3px 0 var(--paper-shadow);
    overflow-x: auto;
    scrollbar-width: none;
  }
  .harness-grid::-webkit-scrollbar { display: none; }
  .harness-item {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 96px;
    padding: 12px 6px;
    background: var(--card);
    color: var(--ink);
    font-size: 14px;
    font-weight: 500;
    white-space: nowrap;
  }
  .harness-item.reference { background: var(--panel-2); }
  .harness-label { display:flex; flex-direction:column; gap:5px; text-align:left; }
  .harness-label small { color:var(--ink-2); font:8px 'Geist Mono',monospace; letter-spacing:.08em; }
  .harness-icon {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    flex: none;
    border: 1px solid var(--line-2);
    background: #ffffff !important;
  }
  .harness-icon img {
    width: 26px;
    height: 26px;
    object-fit: contain;
    display: block;
  }
  .harness-note { margin:18px auto 0; font:10px/1.6 'Geist Mono',monospace; color:var(--ink-2); }
  .harness-note a { color:var(--navy); text-underline-offset:3px; }
  .home-section { padding-top:105px; }
  .section-head { display:flex; align-items:end; justify-content:space-between; gap:24px; border-bottom:1px solid var(--line-2); padding-bottom:26px; }
  .section-head h2 { margin:0; }
  .section-head .micro { color:var(--ink-2); white-space:nowrap; }
  .section-copy { display:grid; grid-template-columns:2fr 1fr; align-items:end; gap:50px; padding-top:32px; }
  .section-copy p { max-width:720px; margin:0; font-size:17px; line-height:1.75; }
  .text-link { color:var(--navy); font:12px 'Geist Mono',monospace; text-underline-offset:4px; }
  .capability-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:1px; margin-top:30px; border:1px solid var(--line-2); background:var(--line-2); }
  .capability-card { min-height:225px; padding:25px; background:var(--card); }
  .capability-top { display:flex; align-items:start; justify-content:space-between; color:var(--navy); }
  .capability-icon { font:30px 'Geist Mono',monospace; line-height:1; }
  .capability-card h3 { font-size:27px; margin:30px 0 9px; }
  .capability-card p { font-size:13px; line-height:1.7; margin:0; }
  /* Comparison table — the decision aid, on the page where the decision is
     made. Ruled rows rather than cards: the reader is scanning for a
     difference, so aligned columns and hairlines beat boxed tiles. */
  .compare-grid { margin-top:30px; border:1px solid var(--line-2); background:var(--card); box-shadow:3px 3px 0 var(--paper-shadow); }
  .compare-row { display:grid; grid-template-columns:1.15fr 1fr 1fr; border-top:1px solid var(--line); }
  .compare-row:first-child { border-top:0; }
  .compare-row > span { padding:14px 16px; font-size:13px; line-height:1.5; color:var(--ink-2); border-left:1px solid var(--line); }
  .compare-row > span:first-child { border-left:0; color:var(--ink); }
  .compare-head > span { font:9px 'Geist Mono',monospace; letter-spacing:.14em; text-transform:uppercase; color:var(--ink-2); }
  /* The Shiba column is the one the page argues for. Tinting a single column
     keeps the navy accent in one place instead of scattering it. */
  .compare-shiba { background:var(--panel-2); color:var(--ink); font-weight:500; }
  .compare-head .compare-shiba { color:var(--navy); font-weight:600; }
  /* The per-cell column label is redundant beside its header on wide screens
     and load-bearing once the columns stack, so it is switched, not repeated. */
  .compare-col-label { display:none; }
  .steps-grid h3 { font-size:27px; margin:30px 0 9px; }
  .steps-grid p { font-size:13px; line-height:1.7; margin:0; }
  .steps-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:32px; padding-top:30px; }
  .steps-grid { gap:20px; padding-top:36px; }
  .step-card { border-top:2px solid var(--navy); padding-top:18px; display:flex; flex-direction:column; }
  /* Screen card — dark navy matching illustration backgrounds */
  .step-dither-screen { position:relative; overflow:hidden; background:#131520; border:1px solid #2a3050; margin-bottom:20px; box-shadow:3px 3px 0 #0006; display:flex; flex-direction:column; transition:transform 300ms cubic-bezier(.2,.7,.2,1), box-shadow 300ms ease; }
  @media (hover: hover) and (pointer: fine) {
    .step-card:hover .step-dither-screen { transform:translateY(-4px); box-shadow:5px 8px 0 #0009; }
    .step-card:hover .step-illustration img { transform:scale(1.04); }
  }
  .step-illustration { position:relative; width:100%; aspect-ratio:1672 / 941; flex:none; overflow:hidden; background:#131520; }
  .step-illustration img { display:block; width:100%; height:100%; object-fit:cover; object-position:center center; transition:transform 400ms cubic-bezier(.2,.7,.2,1); }
  .step-illustration img { image-rendering:pixelated; }
  .step-illustration .dithered-dark { display:none; position:absolute; inset:0; }
  :root[data-theme='dark'] .step-illustration .dithered-light { visibility:hidden; }
  :root[data-theme='dark'] .step-illustration .dithered-dark { display:block; }
  @media (prefers-reduced-motion: reduce) {
    .step-illustration img { transition: none; transform: none; }
  }
  .steps-grid h3 { margin:18px 0 10px; }
  .closing { display:flex; justify-content:space-between; align-items:center; gap:30px; margin-top:110px; padding:38px; border:1px solid var(--line-2); background:var(--card); box-shadow:3px 3px 0 var(--paper-shadow); }
  .closing h2 { margin:12px 0 8px; }
  .closing p:last-child { margin:0; }
  .closing-actions { flex:none; margin:0; }
