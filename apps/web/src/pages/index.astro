---
import MarketingPage from '../layouts/MarketingPage.astro';

const description = 'A self-hosted AI engineer that asks before it writes code. Runs in your Cloudflare account, on Claude Code, Codex, OpenCode, or Devin.';
const schema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Shiba',
  url: 'https://tryshiba.dev/',
  description,
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Web',
  license: 'https://spdx.org/licenses/AGPL-3.0-only.html',
  sameAs: ['https://github.com/princepal9120/shiba', 'https://x.com/prince_twets'],
};

// The switch reasons, stated as flat claims. Adjectives are deliberately
// absent — each row names a concrete thing the buyer either gets or does not.
const comparisons = [
  { point: 'Runs in infrastructure you own', shiba: 'Your Cloudflare account', them: "The provider's account" },
  { point: 'Model and harness per run', shiba: 'Claude Code, Codex, OpenCode, Devin', them: 'Chosen by the provider' },
  { point: 'Approval before code runs', shiba: 'Required by default', them: 'Varies by product' },
  { point: 'Who holds the credentials', shiba: 'You do, at egress', them: 'Held by the provider' },
  { point: 'License', shiba: 'AGPL-3.0, source readable', them: 'Proprietary' },
];
---

<MarketingPage title="Shiba - Your AI software engineer" description={description} path="/" schema={schema}>
  <section class="shell home-hero" aria-labelledby="home-title">
    <div class="hero-copy">
      <p class="eyebrow">OPEN-SOURCE DEVIN CLOUD ALTERNATIVE</p>
      <h1 id="home-title">It asks before<br /><em>it writes code.</em></h1>
      <p class="hero-lead">An AI engineer that runs in your own Cloudflare account, shows you the exact command it wants to run, and waits for your yes. Your keys stay outside the Cloudflare Sandbox. Your repo, your models, your rules.</p>
      <div class="hero-actions">
        <a class="button" href="/docs/getting-started/">Run it on your repo <span aria-hidden="true">↗</span></a>
      </div>
      <p class="hero-note">No hosted black box. No sandbox starts before your approval.</p>
      <ul class="hero-proof">
        <li class="hero-proof-item"><span class="hero-proof-label">0</span><span class="hero-proof-detail">servers you don't control. It runs in your Cloudflare account.</span></li>
        <li class="hero-proof-item"><span class="hero-proof-label">1</span><span class="hero-proof-detail">approval before any code runs. Reject and nothing executes.</span></li>
        <li class="hero-proof-item"><span class="hero-proof-label">4</span><span class="hero-proof-detail">agents to choose from: Claude Code, Codex, OpenCode, Devin.</span></li>
      </ul>
    </div>

    <div class="work-window" aria-label="Illustration of Shiba's approval-gated task flow">
      <div class="window-titlebar">
        <span class="window-brand"><img src="/assets/mascot/pet-logo.png" alt="" width="18" height="18" /> shiba.workspace</span>
        <span class="window-controls" aria-hidden="true"><i>–</i><i>□</i><i>×</i></span>
      </div>
      <div class="window-menu" aria-hidden="true">Task&nbsp;&nbsp; Review&nbsp;&nbsp; Workspace</div>
      <div class="window-body">
        <div class="window-topline"><span>CODING TASK</span><span>01 / 03</span></div>
        <div class="approval-art" aria-hidden="true">
          <img src="/assets/shiba-working.png" alt="" width="1200" height="1200" fetchpriority="high" class="shiba-working-img" />
          <div class="anim-overlay">
            <!-- The pending tool input, verbatim. The agent is stopped here
                 until a human answers — which is the whole product. -->
            <div class="ask-card">
              <div class="ask-head"><span class="ask-pulse"></span><span>APPROVAL REQUIRED</span></div>
              <pre class="ask-cmd"><code><span class="ask-verb">delegate_coding_task</span>(&#123;
  repo:   <span class="ask-str">"acme/api"</span>,
  task:   <span class="ask-str">"fix token refresh race"</span>,
  branch: <span class="ask-str">"fix/auth-race"</span>
&#125;)</code></pre>
              <div class="ask-actions"><span class="ask-yes">APPROVE</span><span class="ask-no">REJECT</span></div>
            </div>
          </div>
          <span class="art-stamp">A CLEAR PLAN. YOUR CALL.</span>
        </div>
        <div class="task-paper">
          <div class="task-icon"><img src="/assets/mascot/pet-logo.png" alt="" width="42" height="42" /></div>
          <div><span class="micro">YOUR REPOSITORY</span><strong>Make a change. Keep control.</strong><small>Repository and task input are reviewed together.</small></div>
        </div>
        <div class="workflow-step"><span class="step-num">01</span><span><strong>Describe the task</strong><small>Repository · branch · instructions</small></span><span class="step-state">READY</span></div>
        <div class="workflow-step current"><span class="step-num">02</span><span><strong>Approval before execution</strong><small>Review the exact tool input</small></span><span class="step-state">YOUR CALL</span></div>
        <div class="workflow-step"><span class="step-num">03</span><span><strong>Inspect the work</strong><small>Progress · changed files · diff</small></span><span class="step-state">AFTER APPROVAL</span></div>
        <div class="window-caption">The agent proposes. You decide when it runs.</div>
      </div>
      <div class="window-status"><span>HUMAN IN THE LOOP</span><span>ISOLATED SANDBOX</span></div>
    </div>
  </section>

  <div class="shell compatibility" aria-label="Ways to use Shiba"><span>USE FROM</span><span>Web</span><span>Slack</span><span>Telegram</span><span>Discord</span><span>GitHub</span><span class="compatibility-end">Mobile web is available; native iPhone app is on the roadmap.</span></div>

  <section id="harnesses" class="shell harness-section" aria-labelledby="harness-title">
    <p class="eyebrow">TOOLS &amp; MODEL PROVIDERS</p>
    <h2 id="harness-title">Bring your tools. Keep control.</h2>
    <p class="harness-lead">All four harnesses are supported — pick OpenCode, Claude Code, Codex, or Devin CLI, and run them with your own provider credentials. Other logos are shown for reference—not as claims of a Shiba integration.</p>
    <div class="harness-grid" role="list" aria-label="Coding tools and model providers">
      <div class="harness-item integrated" role="listitem"><span class="harness-icon"><img src="/assets/harnesses/opencode.svg" alt="" width="32" height="32" /></span><span class="harness-label">OpenCode<small>INTEGRATED</small></span></div>
      <div class="harness-item integrated" role="listitem"><span class="harness-icon"><img src="/assets/harnesses/claude.svg" alt="" width="32" height="32" /></span><span class="harness-label">Claude Code<small>INTEGRATED</small></span></div>
      <div class="harness-item integrated" role="listitem"><span class="harness-icon"><img src="/assets/harnesses/openai.svg" alt="" width="32" height="32" /></span><span class="harness-label">Codex<small>INTEGRATED</small></span></div>
      <div class="harness-item integrated" role="listitem"><span class="harness-icon"><img src="/assets/harnesses/devin.svg" alt="" width="32" height="32" /></span><span class="harness-label">Devin CLI<small>INTEGRATED</small></span></div>
      <div class="harness-item reference" role="listitem"><span class="harness-icon"><img src="/assets/harnesses/cursor.svg" alt="" width="32" height="32" /></span><span class="harness-label">Cursor<small>NOT INTEGRATED</small></span></div>
      <div class="harness-item reference" role="listitem"><span class="harness-icon"><img src="/assets/harnesses/grok.svg" alt="" width="32" height="32" /></span><span class="harness-label">Grok<small>MODEL REFERENCE</small></span></div>
    </div>
    <p class="harness-note">Product names and logos belong to their respective owners. No affiliation is implied. <a href="/docs/claude-code/">See supported configuration →</a></p>
  </section>

  <section id="channels" class="shell home-section channels-section" aria-labelledby="channels-title">
    <div class="section-head">
      <div>
        <p class="eyebrow">TRIGGER FROM ANYWHERE</p>
        <h2 id="channels-title">Trigger @shiba.<br /><em>Get work done from anywhere.</em></h2>
      </div>
      <p class="micro">SLACK · MOBILE WEB · TELEGRAM · DISCORD</p>
    </div>
    <div class="channels-intro">
      <p>Whether you are at your desk, on Slack, or on your phone, trigger <code>@shiba</code> to delegate a task. Review the exact plan, approve with one tap, and follow sandbox progress end-to-end.</p>
    </div>
    <div class="channels-grid">
      <div class="channel-card">
        <div class="channel-top">
          <span class="channel-icon"><img src="/assets/channels/slack.svg" alt="" width="22" height="22" /></span>
          <span class="channel-badge live">● LIVE CHATOPS</span>
        </div>
        <h3>Slack</h3>
        <div class="channel-bubble">
          <span class="bubble-prompt"><strong class="highlight">@shiba</strong> fix the token refresh race in auth.ts</span>
          <span class="bubble-reply">↳ Generated plan ready for review</span>
        </div>
        <p>Trigger in any channel or thread. Approvals arrive as interactive Block Kit cards with diff previews.</p>
      </div>

      <div class="channel-card">
        <div class="channel-top">
          <span class="channel-icon"><img src="/assets/channels/iphone.svg" alt="" width="22" height="22" /></span>
          <span class="channel-badge live">● MOBILE WEB</span>
        </div>
        <h3>Mobile web</h3>
        <div class="channel-bubble">
          <span class="bubble-prompt"><strong class="highlight">Add to Home Screen</strong> · Standalone App</span>
          <span class="bubble-reply">↳ 1-tap review &amp; sandbox approval</span>
        </div>
        <p>Mobile-optimized dashboard. Review proposed tool inputs, follow logs, and inspect diffs from anywhere.</p>
      </div>

      <div class="channel-card">
        <div class="channel-top">
          <span class="channel-icon"><img src="/assets/channels/telegram.svg" alt="" width="22" height="22" /></span>
          <span class="channel-badge live">● LIVE CHATOPS</span>
        </div>
        <h3>Telegram</h3>
        <div class="channel-bubble">
          <span class="bubble-prompt"><strong class="highlight">/shiba</strong> deploy staging hotfix --branch main</span>
          <span class="bubble-reply">↳ Webhook dispatch &amp; inline buttons</span>
        </div>
        <p>Direct bot interaction with cryptographic webhook dispatch and inline button approval gates end-to-end.</p>
      </div>

      <div class="channel-card">
        <div class="channel-top">
          <span class="channel-icon"><img src="/assets/channels/discord.svg" alt="" width="22" height="22" /></span>
          <span class="channel-badge live">● LIVE CHATOPS</span>
        </div>
        <h3>Discord</h3>
        <div class="channel-bubble">
          <span class="bubble-prompt"><strong class="highlight">/shiba</strong> task repo:backend issue:#142</span>
          <span class="bubble-reply">↳ Threaded run logs &amp; diff previews</span>
        </div>
        <p>Slash commands and bot mentions for developer servers, with threaded progress updates and sandbox review.</p>
      </div>
    </div>
  </section>

  <section class="shell home-section" aria-labelledby="why-title">
    <div class="section-head"><h2 id="why-title">The agent does the work.<br /><em>You keep the keys.</em></h2><p class="micro">ONE DEPLOYMENT · ONE CONTROL PLANE</p></div>
    <div class="section-copy"><p>An AI coding tool is worth exactly as much as the boundary around it. Shiba runs in your Cloudflare account, requires human approval before sandbox execution by default, and shows resulting changes instead of asking you to take completion on faith.</p><a class="text-link" href="/why-shiba/">Why we built it <span aria-hidden="true">↗</span></a></div>
  </section>

  <section class="shell home-section compare" aria-labelledby="compare-title">
    <div class="section-head"><h2 id="compare-title">Why switch off a hosted agent.</h2><p class="micro">SHIBA VS A MANAGED CLOUD AGENT</p></div>
    <div class="compare-grid" role="table" aria-label="Shiba compared with a managed cloud coding agent">
      <div class="compare-row compare-head" role="row">
        <span role="columnheader"></span>
        <span role="columnheader" class="compare-shiba"><span class="compare-col-label">Shiba</span><span class="compare-col-full">SHIBA</span></span>
        <span role="columnheader"><span class="compare-col-label">Managed cloud agent</span><span class="compare-col-full">MANAGED CLOUD AGENT</span></span>
      </div>
      {comparisons.map((row) => (
        <div class="compare-row" role="row">
          <span role="cell">{row.point}</span>
          <span role="cell" class="compare-shiba"><span class="compare-col-label">Shiba</span><span class="compare-col-full">{row.shiba}</span></span>
          <span role="cell"><span class="compare-col-label">Managed cloud agent</span><span class="compare-col-full">{row.them}</span></span>
        </div>
      ))}
    </div>
  </section>

  <section class="shell home-section steps" aria-labelledby="steps-title">
    <div class="section-head"><h2 id="steps-title">From task to inspectable diff</h2><p class="micro">THE APPROVAL GATE IS THE WORKFLOW</p></div>
    <div class="steps-grid">
      <div class="step-card">
        <div class="step-dither-screen" aria-hidden="true">
          <div class="step-illustration"><img src="/assets/shiba-card-01-repo.png" alt="" width="1672" height="941" loading="lazy" /></div>
        </div>
        <span class="micro">01 / CONNECT</span>
        <h3>Bring a repository</h3>
        <p>Paste an HTTPS GitHub repository URL and describe the coding task in the dashboard.</p>
      </div>

      <div class="step-card">
        <div class="step-dither-screen" aria-hidden="true">
          <div class="step-illustration"><img src="/assets/shiba-card-02-approval.png" alt="" width="1672" height="941" loading="lazy" /></div>
        </div>
        <span class="micro">02 / DECIDE</span>
        <h3>Approve or reject</h3>
        <p>Inspect the proposed tool input. By default, Shiba waits for your approval before starting a sandbox.</p>
      </div>

      <div class="step-card">
        <div class="step-dither-screen" aria-hidden="true">
          <div class="step-illustration"><img src="/assets/shiba-card-03-diff.png" alt="" width="1672" height="941" loading="lazy" /></div>
        </div>
        <span class="micro">03 / REVIEW</span>
        <h3>See what changed</h3>
        <p>Follow progress and review changed files and the diff. Publishing a pull request is optional.</p>
      </div>
    </div>
  </section>

  <section class="shell closing" aria-labelledby="closing-title"><div><p class="eyebrow">BUILD WITH YOUR OWN AGENT</p><h2 id="closing-title">Put software engineer in your cloud.</h2><p>Open source (AGPL-3.0), self-hosted, and yours to fork. It takes one command to run it against a repo you own.</p></div><div class="closing-actions"><a class="button" href="/docs/getting-started/">Run it on your repo <span aria-hidden="true">↗</span></a></div></section>
</MarketingPage>

<style>
  /* Hero rhythm — 4-unit base. The label belongs to the headline (tight), the
     headline-to-lead break is the section's main pause, then intervals tighten
     toward the quiet note so the column tapers instead of repeating one value. */
  .home-hero { display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1fr); gap:56px; align-items:start; padding-block:56px 72px; min-height:710px; --hero-gap-tight:16px; --hero-gap-lg:36px; --hero-gap-md:28px; --hero-gap-sm:20px; }
  .hero-copy { animation:hero-arrive 560ms cubic-bezier(.2,.7,.2,1) both; }
  /* Size the headline to the measure it actually has, not to the viewport.
     10.9cqi keeps "Your AI software engineer." on one line at every column
     width; balance is the backstop when webfont metrics fall back. */
  .hero-copy { container-type:inline-size; }
  .hero-copy h1 { max-width:none; margin:var(--hero-gap-tight) 0 var(--hero-gap-lg); font-size:clamp(32px,10.9cqi,84px); line-height:1.03; text-wrap:balance; }
  .hero-copy h1 em, .home-section h2 em { color:var(--navy); font-weight:400; }
  .hero-lead { max-width:46ch; font-size:16px; line-height:1.65; text-wrap:pretty; }
  .hero-actions, .closing-actions { display:flex; flex-wrap:wrap; align-items:center; gap:12px; margin-top:28px; }
  .home-hero .hero-actions { margin-top:var(--hero-gap-md); }
  .hero-note { display:flex; align-items:flex-start; gap:8px; margin-top:var(--hero-gap-sm); font:10px 'Geist Mono',monospace; letter-spacing:.02em; }
  .hero-note::before { content:''; flex:none; width:6px; height:6px; margin-top:4px; background:var(--navy); }
  /* Proof row: ruled strip, matching the compatibility-strip idiom in design.md.
     Mono label carries the fact, Geist carries the explanation. */
  .hero-proof { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); margin:var(--hero-gap-lg) 0 0; padding:0; list-style:none; border-top:1px solid var(--line); }
  .hero-proof-item { display:flex; flex-direction:column; gap:6px; padding:16px 16px 0 0; }
  .hero-proof-item + .hero-proof-item { padding-left:16px; border-left:1px solid var(--line); }
  .hero-proof-item:last-child { padding-right:0; }
  /* The label IS the number (0 / 1 / 4), so it takes display type rather than
     the 9px mono caption the label idiom uses for words. */
  .hero-proof-label { font-family:'Instrument Serif',Georgia,serif; font-size:44px; line-height:.9; color:var(--navy); }
  .hero-proof-detail { font-size:12px; line-height:1.45; color:var(--ink-2); }
  .work-window { border:1px solid var(--input-line); background:var(--panel-2); padding:4px; box-shadow:6px 6px 0 var(--paper-shadow); transition:transform 220ms ease, box-shadow 220ms ease; animation:hero-arrive 680ms 100ms cubic-bezier(.2,.7,.2,1) both; }
  .work-window:focus-within { transform:translateY(-3px); box-shadow:8px 9px 0 var(--paper-shadow); }
  @media (hover: hover) and (pointer: fine) {
    .work-window:hover { transform:translateY(-3px); box-shadow:8px 9px 0 var(--paper-shadow); }
  }
  .window-titlebar { display:flex; justify-content:space-between; align-items:center; min-height:29px; padding:3px 4px 3px 9px; color:var(--paper-title-fg); background:var(--paper-title); font:11px 'Geist Mono',monospace; }
  .window-brand { display:flex; align-items:center; gap:7px; }
  .window-brand img, .task-icon img { image-rendering:pixelated; background:#fff; }
  .window-controls { display:flex; gap:2px; }
  .window-controls i { display:grid; place-items:center; width:16px; height:15px; background:#bdbdbd; border:1px solid #444; border-top-color:#f5f5f5; border-left-color:#f5f5f5; color:#111; font:normal 11px Arial,sans-serif; }
  .window-menu { padding:6px 10px; border-bottom:1px solid var(--input-line); color:var(--ink); font:10px 'Geist Mono',monospace; }
  .window-body { padding:24px; background:var(--card); }
  .window-topline, .window-status, .micro, .step-state, .step-num, .window-caption { font-family:'Geist Mono',monospace; font-size:10px; letter-spacing:.06em; }
  .window-topline { display:flex; justify-content:space-between; color:var(--ink-2); margin-bottom:16px; }
  .approval-art { position:relative; height:190px; overflow:hidden; margin-bottom:18px; border:1px solid var(--line-2); background:#171918; }
  .approval-art { height:240px; }
  .approval-art img.shiba-working-img { display:block; width:100%; height:100%; object-fit:cover; object-position:center 22%; transition:transform 700ms cubic-bezier(.2,.7,.2,1); }
  .work-window:focus-within .approval-art img { transform:scale(1.045) translateY(-5px); }
  @media (hover: hover) and (pointer: fine) {
    .work-window:hover .approval-art img { transform:scale(1.045) translateY(-5px); }
  }
  .art-stamp { position:absolute; left:12px; bottom:12px; padding:6px 8px; border:1px solid #9cbce277; background:#171918d9; color:#b4cde9; font:9px 'Geist Mono',monospace; letter-spacing:.12em; }
  /* ── Animated illustration overlay ── */
  .anim-overlay { position:absolute; inset:0; pointer-events:none; }
  /* The card is centred over the illustration: it is the subject, not a
     decoration on top of one. */
  .anim-overlay { display:flex; align-items:center; justify-content:center; padding:16px; }
  /* Opaque, not translucent: the illustration behind it is busy, and the
     payload has to be readable at a glance. */
  .ask-card { width:100%; max-width:330px; background:#0e0f0e; border:1px solid var(--navy); box-shadow:3px 3px 0 #0008; animation:chip-in 0.5s 0.25s cubic-bezier(.2,.8,.2,1) both; }
  /* #0000a8 is fixed in both themes, so the header text stays white — the
     theme-aware navy is a light tint in dark mode and would vanish here. */
  .ask-head { display:flex; align-items:center; gap:7px; padding:7px 10px; background:#0000a8; color:#fff; font:8.5px 'Geist Mono',monospace; letter-spacing:.14em; }
  .ask-pulse { width:5px; height:5px; background:currentColor; animation:blink 1.1s steps(2,start) infinite; }
  .ask-cmd { margin:0; padding:11px 12px; font:9.5px/1.65 'Geist Mono',monospace; color:var(--ink); white-space:pre; overflow-x:auto; }
  .ask-verb { color:var(--navy); font-weight:600; }
  .ask-str { color:var(--ink-2); }
  .ask-actions { display:flex; border-top:1px solid var(--line); }
  /* Approve is the only filled control — one filled action per screen. */
  .ask-actions span { flex:1; padding:7px 10px; text-align:center; font:8.5px 'Geist Mono',monospace; letter-spacing:.12em; }
  .ask-yes { background:var(--navy); color:#fff; }
  html[data-theme='dark'] .ask-yes { color:#152335; }
  .ask-no { border-left:1px solid var(--line); color:var(--ink-2); }
  /* Glowing approval badge — top-right, matches illustration's neon card */
  .glow-check { position:absolute; top:8px; right:6px; display:flex; align-items:center; gap:6px; padding:5px 10px; background:#071525f0; border:1px solid #1e6bcc; border-radius:5px; font:8.5px 'Geist Mono',monospace; color:#7dd3fc; opacity:0; animation:chip-in 0.7s 1.6s cubic-bezier(.2,.8,.2,1) forwards, glow-pulse 3s 2.3s ease-in-out infinite; }
  .glow-check em { font-style:normal; color:#c3e88d; }
  /* Steam from mug — positioned ~63% from left, matching mug in illustration */
  .steam-particles { position:absolute; bottom:12px; left:63%; }
  .steam { display:block; position:absolute; width:4px; border-radius:3px; background:linear-gradient(to top,#94a3b855,#94a3b800); opacity:0; animation:steam-rise 2.6s ease-in-out infinite; }
  .s1 { height:18px; left:0;   animation-delay:0s;   animation-duration:2.6s; }
  .s2 { height:13px; left:7px; animation-delay:0.9s; animation-duration:2.1s; }
  .s3 { height:20px; left:3px; animation-delay:1.7s; animation-duration:3s;   }
  /* Terminal snippet — bottom-right */
  .terminal-snip { position:absolute; bottom:8px; right:6px; padding:5px 9px; background:#0a0e17f2; border:1px solid #2a3040; border-radius:4px; font:8.5px/1.6 'Geist Mono',monospace; color:#6e7681; opacity:0; animation:chip-in 0.5s 2s cubic-bezier(.2,.8,.2,1) forwards; }
  .t-prompt { color:#3ddfa5; }
  .t-dots { display:inline-flex; gap:3px; vertical-align:middle; margin-left:4px; }
  .t-dots span { display:block; width:4px; height:4px; border-radius:50%; background:#3ddfa5; animation:dot-bounce 1.2s ease-in-out infinite; }
  .t-dots span:nth-child(2) { animation-delay:.2s; }
  .t-dots span:nth-child(3) { animation-delay:.4s; }
  /* Paw-tap ripple on keyboard area */
  .paw-ripple { position:absolute; bottom:18px; left:50%; translate:-50% 0; width:28px; height:14px; border-radius:50%; border:2px solid #1e90ff55; opacity:0; animation:paw-tap 2.4s 1s ease-out infinite; }
  /* ── Keyframes ── */
  @keyframes chip-in     { from { opacity:0; transform:translateY(8px) scale(.95); } to { opacity:1; transform:translateY(0) scale(1); } }
  .task-paper { display:flex; align-items:center; gap:18px; padding:19px; background:var(--paper); border:1px solid var(--line-2); margin-bottom:20px; }
