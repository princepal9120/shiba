---
import '../styles/tailwind.css';
import '../styles/theme.css';
---
<!DOCTYPE html>
<html lang="en" class="dark scroll-smooth">
<head>
  <meta charset="utf-8" />
  <link rel="icon" type="image/svg+xml" href="/assets/brand/logo.svg" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Shiba - The best AI software engineer</title>
  <meta name="description" content="Shiba is the best AI software engineer. Delegate tasks to parallel coding agents that plan, build, and ship — from task to merged PR." />
  <link rel="canonical" href="https://tryshiba.dev/" />
  <link rel="sitemap" href="/sitemap.xml" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Shiba" />
  <meta property="og:url" content="https://tryshiba.dev/" />
  <meta property="og:title" content="Shiba - The best AI software engineer" />
  <meta property="og:description" content="Delegate tasks to parallel coding agents that plan, build, and ship — from task to merged PR." />
  <meta property="og:image" content="https://tryshiba.dev/assets/brand/logo.svg" />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:site" content="@prince_twets" />
  <meta name="twitter:title" content="Shiba - The best AI software engineer" />
  <meta name="twitter:description" content="Delegate tasks to parallel coding agents that plan, build, and ship — from task to merged PR." />
  <meta name="twitter:image" content="https://tryshiba.dev/assets/brand/logo.svg" />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "Shiba",
    url: "https://tryshiba.dev/",
    description: "Open-source, self-hosted AI software engineer: approval-gated coding tasks run in isolated Cloudflare Sandbox containers, from task to merged PR.",
    applicationCategory: "DeveloperApplication",
    operatingSystem: "Web",
    license: "https://opensource.org/licenses/MIT",
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
    sameAs: ["https://github.com/princepal9120/shiba", "https://x.com/prince_twets"],
  })} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Mono:ital,wght@0,400;0,500;1,400&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />

  <style is:global>
    :root {
      --bg: #0a0a0b;
      --panel: #101013;
      --elevated: #161619;
      --line: rgba(255, 255, 255, 0.07);
      --accent: #2dd4bf;
    }

    body {
      background-color: #0a0a0b !important;
      color: #e4e4e7 !important;
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      margin: 0;
      padding: 0;
      overflow-x: hidden;
      -webkit-font-smoothing: antialiased;
    }

    .font-mono {
      font-family: 'DM Mono', ui-monospace, SFMono-Regular, monospace !important;
    }
  </style>
</head>
<body class="bg-[#0a0a0b] text-zinc-200 antialiased selection:bg-teal-500/20 selection:text-teal-200">

  <!-- TOP NAVIGATION BAR -->
  <header class="sticky top-0 z-50 w-full border-b border-white/[0.07] bg-[#0a0a0b]">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 h-12 flex items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <a href="/" class="flex items-center gap-2.5 text-zinc-100 hover:text-white transition-colors">
          <img src="/assets/brand/logo.svg" alt="Shiba" class="w-5 h-5" />
          <span class="font-semibold text-sm tracking-tight text-zinc-100">Shiba</span>
        </a>
        <span class="inline-flex items-center gap-1.5 px-2 py-0.5 text-[11px] font-mono text-zinc-400 border border-white/[0.07] rounded bg-[#101013]">
          <span class="w-1.5 h-1.5 rounded-full bg-[#2dd4bf]"></span>
          <span>v0.1.0</span>
        </span>
      </div>

      <nav aria-label="Main navigation" class="hidden md:flex items-center gap-6 text-xs text-zinc-400">
        <a href="/docs/overview" class="hover:text-zinc-200 transition-colors">Documentation</a>
        <a href="/docs/getting-started" class="hover:text-zinc-200 transition-colors">Quickstart</a>
        <a href="/docs/architecture" class="hover:text-zinc-200 transition-colors">Architecture</a>
        <a href="/docs/security" class="hover:text-zinc-200 transition-colors">Security</a>
        <a href="https://github.com/princepal9120/shiba" target="_blank" rel="noopener noreferrer" class="hover:text-zinc-200 transition-colors">GitHub ↗</a>
      </nav>

      <div class="flex items-center gap-3">
        <a href="/docs/getting-started" class="hidden sm:inline-flex text-xs font-medium text-zinc-400 hover:text-zinc-200 transition-colors">Docs</a>
        <a href="/app/" class="bg-zinc-100 hover:bg-white text-zinc-900 font-medium text-xs px-3 py-1.5 rounded-md transition-colors">Open App</a>
      </div>
    </div>
  </header>

  <main>
    <!-- HERO SECTION -->
    <section class="grid-bg relative py-20 sm:py-28 border-b border-white/[0.07] text-center">
      <div class="max-w-4xl mx-auto px-4 sm:px-6">
        
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-white/[0.07] bg-[#101013] text-[11px] font-mono text-zinc-400 mb-6">
          <span class="w-1.5 h-1.5 rounded-full bg-[#2dd4bf]"></span>
          <span class="uppercase tracking-wider">THE BEST SELF-HOSTED</span>
          <span class="text-zinc-600">·</span>
          <span>SANDBOX WORKSPACE</span>
        </div>

        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-semibold tracking-tight text-zinc-100 leading-tight">
          AI SOFTWARE ENGINEER
        </h1>

        <p class="mt-5 text-base sm:text-lg text-zinc-400 max-w-2xl mx-auto leading-relaxed">
          Open-source coding agents running in isolated Cloudflare Sandboxes. Submit tasks from Slack or Dashboard with human approval gates, automated test verification, and clean PR delivery.
        </p>

        <div class="flex flex-wrap items-center justify-center gap-3 mt-8">
          <a href="/app/" class="bg-zinc-100 hover:bg-white text-zinc-900 font-medium text-sm px-4 py-2 rounded-md transition-colors inline-flex items-center gap-2">
            <span>Launch Dashboard</span>
            <span class="text-zinc-500">→</span>
          </a>
          <a href="/docs/getting-started" class="border border-white/10 hover:bg-white/5 text-zinc-300 font-medium text-sm px-4 py-2 rounded-md transition-colors inline-flex items-center gap-2">
            <span>Quickstart Guide</span>
          </a>
          <a href="https://github.com/princepal9120/shiba" target="_blank" rel="noopener noreferrer" class="border border-white/10 hover:bg-white/5 text-zinc-400 hover:text-zinc-200 text-sm px-3 py-2 rounded-md transition-colors">
            <span>GitHub</span>
          </a>
        </div>

        <!-- HERO DEMO / WORKBENCH TERMINAL PREVIEW -->
        <div class="mt-14 max-w-3xl mx-auto text-left bg-[#101013] border border-white/[0.07] rounded-lg overflow-hidden">
          
          <div class="h-10 px-4 border-b border-white/[0.07] bg-[#161619] flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-zinc-700"></span>
              <span class="w-2 h-2 rounded-full bg-zinc-700"></span>
              <span class="w-2 h-2 rounded-full bg-zinc-700"></span>
              <span class="ml-2 text-xs font-mono text-zinc-400">task-run-482 · sandbox micro-vm</span>
            </div>
            <button id="hero-replay-btn" class="border border-white/10 hover:bg-white/5 text-zinc-300 text-xs font-mono px-2.5 py-1 rounded transition-colors flex items-center gap-1.5 cursor-pointer">
              <span class="w-1.5 h-1.5 rounded-full bg-[#2dd4bf]"></span>
              <span>Replay run</span>
            </button>
          </div>

          <div class="px-4 py-2 border-b border-white/[0.07] bg-[#101013] flex items-center gap-1 overflow-x-auto text-xs font-mono">
            <button id="tab-all" aria-pressed="true" class="agent-tab px-2.5 py-1 rounded text-zinc-200 bg-white/5 border border-white/10 transition-colors">
              Pipeline View
            </button>
            <button id="tab-captain" aria-pressed="false" class="agent-tab px-2.5 py-1 rounded text-zinc-400 hover:text-zinc-200 transition-colors">
              Planner
            </button>
            <button id="tab-build" aria-pressed="false" class="agent-tab px-2.5 py-1 rounded text-zinc-400 hover:text-zinc-200 transition-colors">
              Sandbox Exec
            </button>
            <button id="tab-review" aria-pressed="false" class="agent-tab px-2.5 py-1 rounded text-zinc-400 hover:text-zinc-200 transition-colors">
              Verification
            </button>
          </div>

          <div id="demo-step-display" class="p-4 sm:p-5 font-mono text-xs text-zinc-300 space-y-3 bg-[#0e0e11]">
            <div class="text-[11px] text-zinc-500 uppercase tracking-wider flex items-center justify-between pb-1 border-b border-white/[0.05]">
              <span>PIPELINE ORCHESTRATION · BRANCH: FIX-AUTH-TOKEN</span>
              <span class="text-[#2dd4bf] font-medium">LIVE</span>
            </div>

            <div class="space-y-2 pt-1" data-demo-agent="all">
              <div class="flex items-start gap-3">
                <span class="text-zinc-500">01</span>
                <div class="flex-1">
                  <div class="text-zinc-200 font-medium">01. Approval-Gated: Plan verification before execution</div>
                  <div class="text-zinc-500 text-[11px] mt-0.5">Plan reviewed by security rules · Slack sign-off confirmed</div>
                </div>
                <span class="text-xs text-emerald-400">approved</span>
              </div>

              <div class="flex items-start gap-3">
                <span class="text-zinc-500">02</span>
                <div class="flex-1">
                  <div class="text-zinc-200 font-medium">02. Sandbox Environment Provisioned</div>
                  <div class="text-zinc-500 text-[11px] mt-0.5">Cloudflare micro-VM · Node.js 22 · Egress boundary active</div>
                </div>
                <span class="text-xs text-emerald-400">ready</span>
              </div>

              <div class="flex items-start gap-3">
                <span class="text-zinc-500">03</span>
                <div class="flex-1">
                  <div class="text-zinc-200 font-medium">03. Harness Exec: OpenCode / Claude Code / Codex</div>
                  <div class="text-zinc-500 text-[11px] mt-0.5">14 files inspected · 2 targeted edits · 32 tests passed</div>
                </div>
                <span class="text-xs text-[#2dd4bf]">completed</span>
              </div>

              <div class="flex items-start gap-3">
                <span class="text-zinc-500">04</span>
                <div class="flex-1">
                  <div class="text-zinc-200 font-medium">04. Pull Request Published</div>
                  <div class="text-zinc-500 text-[11px] mt-0.5">PR #128 opened on GitHub with diff summary and test traces</div>
                </div>
                <span class="text-xs text-emerald-400">merged</span>
              </div>
            </div>

            <div class="hidden space-y-2 pt-1" data-demo-agent="captain">
              <div class="text-zinc-400">Captain Agent · Task decomposition</div>
              <div class="p-2.5 rounded bg-[#161619] border border-white/[0.07] text-zinc-300 text-[11px] space-y-1">
                <div>• Parsed Slack command: "Fix session token expiry in auth middleware"</div>
                <div>• Generated execution DAG: 2 read ops, 1 patch, 1 test run</div>
                <div>• Approval Gate: Waiting for operator sign-off before git push</div>
              </div>
            </div>

            <div class="hidden space-y-2 pt-1" data-demo-agent="build">
              <div class="text-zinc-400">Sandbox Worker · Isolated execution</div>
              <div class="p-2.5 rounded bg-[#161619] border border-white/[0.07] text-zinc-300 text-[11px] space-y-1">
                <div>$ git checkout -b fix-auth-token</div>
                <div>$ pnpm test test/auth.test.ts</div>
                <div class="text-emerald-400">✓ 8 tests passed in 410ms</div>
              </div>
            </div>

            <div class="hidden space-y-2 pt-1" data-demo-agent="review">
              <div class="text-zinc-400">Verifier Agent · Automated quality gate</div>
              <div class="p-2.5 rounded bg-[#161619] border border-white/[0.07] text-zinc-300 text-[11px] space-y-1">
                <div>• Typecheck: PASS (tsc --noEmit)</div>
                <div>• Egress check: Zero unauthorized outbound calls</div>
                <div>• Diff sanity: 2 files changed, +14 lines, -3 lines</div>
              </div>
            </div>

          </div>

          <div class="px-4 py-2.5 border-t border-white/[0.07] bg-[#161619] flex items-center justify-between text-xs text-zinc-500 font-mono">
            <span>Status: 100% Verified</span>
            <a href="/docs/overview" class="text-zinc-400 hover:text-zinc-200 transition-colors">Read architecture overview →</a>
          </div>

        </div>

      </div>
    </section>

    <!-- CORE FEATURES / CAPABILITIES -->
    <section id="features" class="py-20 border-b border-white/[0.07]">
      <div class="max-w-6xl mx-auto px-4 sm:px-6">
        
        <div class="text-center max-w-2xl mx-auto mb-14">
          <div class="text-xs font-mono uppercase tracking-widest text-zinc-500 mb-2">Capabilities</div>
          <h2 class="text-2xl sm:text-3xl font-semibold text-zinc-100 tracking-tight">
            Engineered for safe autonomous execution
          </h2>
          <p class="mt-3 text-sm text-zinc-400">
            Every layer from prompt ingestion to git publish is governed by deterministic boundaries.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          
          <div class="p-5 rounded-lg border border-white/[0.07] bg-[#101013] hover:border-white/15 transition-colors">
            <div class="text-xs font-mono text-[#2dd4bf] mb-2">01. Approval-Gated</div>
            <h3 class="text-sm font-semibold text-zinc-100 mb-1.5">Human sign-off by default</h3>
            <p class="text-xs text-zinc-400 leading-relaxed">
              No code merges or destructive actions execute without explicit operator sign-off via Slack buttons or the dashboard.
            </p>
            <div class="mt-4 pt-3 border-t border-white/[0.05]">
              <a href="/docs/approval-gates" class="text-xs text-zinc-400 hover:text-zinc-200 inline-flex items-center gap-1 transition-colors">
                Learn about gates →
              </a>
            </div>
          </div>

          <div class="p-5 rounded-lg border border-white/[0.07] bg-[#101013] hover:border-white/15 transition-colors">
            <div class="text-xs font-mono text-[#2dd4bf] mb-2">02. Micro-VM Isolation</div>
            <h3 class="text-sm font-semibold text-zinc-100 mb-1.5">Cloudflare Sandbox runtime</h3>
            <p class="text-xs text-zinc-400 leading-relaxed">
              Every job spawns in an isolated ephemeral micro-VM container with strictly scoped filesystem and outbound network controls.
            </p>
            <div class="mt-4 pt-3 border-t border-white/[0.05]">
              <a href="/docs/security" class="text-xs text-zinc-400 hover:text-zinc-200 inline-flex items-center gap-1 transition-colors">
                Security boundaries →
              </a>
            </div>
          </div>

          <div class="p-5 rounded-lg border border-white/[0.07] bg-[#101013] hover:border-white/15 transition-colors">
            <div class="text-xs font-mono text-[#2dd4bf] mb-2">03. Multi-Harness Engine</div>
            <h3 class="text-sm font-semibold text-zinc-100 mb-1.5">OpenCode, Claude Code, Codex</h3>
            <p class="text-xs text-zinc-400 leading-relaxed">
              Route tasks to Anthropic Claude Code, Google OpenCode, or OpenAI Codex with identical approval contracts.
            </p>
            <div class="mt-4 pt-3 border-t border-white/[0.05]">
              <a href="/docs/claude-code" class="text-xs text-zinc-400 hover:text-zinc-200 inline-flex items-center gap-1 transition-colors">
                Supported harnesses →
              </a>
            </div>
          </div>

          <div class="p-5 rounded-lg border border-white/[0.07] bg-[#101013] hover:border-white/15 transition-colors">
            <div class="text-xs font-mono text-[#2dd4bf] mb-2">04. Slack Integration</div>
            <h3 class="text-sm font-semibold text-zinc-100 mb-1.5">Team collaboration channel</h3>
            <p class="text-xs text-zinc-400 leading-relaxed">
              Mention @shiba-ai-coworker in any channel to triage bugs, request features, or review proposed code diffs inline.
            </p>
            <div class="mt-4 pt-3 border-t border-white/[0.05]">
              <a href="/docs/slack" class="text-xs text-zinc-400 hover:text-zinc-200 inline-flex items-center gap-1 transition-colors">
                Slack setup guide →
              </a>
            </div>
          </div>

          <div class="p-5 rounded-lg border border-white/[0.07] bg-[#101013] hover:border-white/15 transition-colors">
            <div class="text-xs font-mono text-[#2dd4bf] mb-2">05. Pull Request Delivery</div>
            <h3 class="text-sm font-semibold text-zinc-100 mb-1.5">Clean commits and GitHub PRs</h3>
            <p class="text-xs text-zinc-400 leading-relaxed">
              Automated branch checkout, focused commits, and structured PR summaries complete with test traces and logs.
            </p>
            <div class="mt-4 pt-3 border-t border-white/[0.05]">
              <a href="/docs/github" class="text-xs text-zinc-400 hover:text-zinc-200 inline-flex items-center gap-1 transition-colors">
                GitHub integration →
              </a>
            </div>
          </div>

          <div class="p-5 rounded-lg border border-white/[0.07] bg-[#101013] hover:border-white/15 transition-colors">
            <div class="text-xs font-mono text-[#2dd4bf] mb-2">06. Self-Hosted & Low Cost</div>
            <h3 class="text-sm font-semibold text-zinc-100 mb-1.5">Own your infrastructure</h3>
            <p class="text-xs text-zinc-400 leading-relaxed">
              Deploy to your Cloudflare account with simple wrangler configuration. Zero seat licenses or opaque markups.
            </p>
            <div class="mt-4 pt-3 border-t border-white/[0.05]">
              <a href="/docs/deployment" class="text-xs text-zinc-400 hover:text-zinc-200 inline-flex items-center gap-1 transition-colors">
                Deployment docs →
              </a>
            </div>
          </div>

        </div>

      </div>
    </section>

    <!-- USE CASES SECTION -->
    <section id="use-cases" class="py-20 border-b border-white/[0.07]">
      <div class="max-w-6xl mx-auto px-4 sm:px-6">
        
        <div class="max-w-2xl mb-12">
          <div class="text-xs font-mono uppercase tracking-widest text-zinc-500 mb-2">Workflows</div>
          <h2 class="text-2xl sm:text-3xl font-semibold text-zinc-100 tracking-tight">
            Built for everyday engineering velocity
          </h2>
          <p class="mt-3 text-sm text-zinc-400">
            Handle routine maintenance, bug investigations, and scheduled repository hygiene without context switching.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          
          <div class="p-5 rounded-lg border border-white/[0.07] bg-[#101013]">
            <div class="flex items-center justify-between mb-3">
              <span class="text-xs font-mono text-zinc-400">E2E BUG TRIAGE & FIX</span>
              <span class="text-[11px] font-mono text-emerald-400 bg-emerald-400/10 px-2 py-0.5 rounded border border-emerald-400/20">VERIFIED</span>
            </div>
            <h3 class="text-sm font-semibold text-zinc-200 mb-1.5">Isolate failures and patch with regression tests</h3>
            <p class="text-xs text-zinc-400 mb-4 leading-relaxed">
              Spawns the test runner in the sandbox, reproduces the failing assertion, modifies source code, and validates that the full suite stays green.
            </p>
            <div class="p-3 rounded bg-[#161619] border border-white/[0.07] font-mono text-[11px] text-zinc-300">
              <div class="text-zinc-500">$ npx vitest run test/auth.test.ts</div>
              <div class="text-emerald-400">✓ test/auth.test.ts (4 tests passed)</div>
            </div>
          </div>

          <div class="p-5 rounded-lg border border-white/[0.07] bg-[#101013]">
            <div class="flex items-center justify-between mb-3">
              <span class="text-xs font-mono text-zinc-400">SCHEDULED REPO SWEEPS</span>
              <span class="text-[11px] font-mono text-teal-400 bg-teal-400/10 px-2 py-0.5 rounded border border-teal-400/20">CRON ACTIVE</span>
            </div>
            <h3 class="text-sm font-semibold text-zinc-200 mb-1.5">Automated security and dependency maintenance</h3>
            <p class="text-xs text-zinc-400 mb-4 leading-relaxed">
              Cron automations trigger nightly sweeps across dependencies, run audit commands, and open structured PRs with changelogs.
            </p>
            <div class="p-3 rounded bg-[#161619] border border-white/[0.07] font-mono text-[11px] text-zinc-300">
              <div class="text-zinc-500">Scheduled: 0 3 * * * (Nightly 03:00 UTC)</div>
              <div>Audit: 0 vulnerabilities found · 2 patch updates available</div>
            </div>
          </div>

          <div class="p-5 rounded-lg border border-white/[0.07] bg-[#101013]">
            <div class="flex items-center justify-between mb-3">
              <span class="text-xs font-mono text-zinc-400">REFACTORING & MODERNIZATION</span>
              <span class="text-[11px] font-mono text-zinc-400 bg-white/5 px-2 py-0.5 rounded border border-white/10">PHASED</span>
            </div>
            <h3 class="text-sm font-semibold text-zinc-200 mb-1.5">Systematic migrations across multi-file surfaces</h3>
            <p class="text-xs text-zinc-400 mb-4 leading-relaxed">
              Executes mechanical refactors (API deprecations, import paths, library migrations) with AST checks and type safety verification.
            </p>
            <div class="p-3 rounded bg-[#161619] border border-white/[0.07] font-mono text-[11px] text-zinc-300">
              <div class="text-zinc-500">Batch migration: 18 files updated</div>
              <div>Typecheck: 0 errors · 0 warnings</div>
            </div>
          </div>

          <div class="p-5 rounded-lg border border-white/[0.07] bg-[#101013]">
            <div class="flex items-center justify-between mb-3">
              <span class="text-xs font-mono text-zinc-400">PULL REQUEST REVIEW & QA</span>
              <span class="text-[11px] font-mono text-emerald-400 bg-emerald-400/10 px-2 py-0.5 rounded border border-emerald-400/20">APPROVAL GATE</span>
            </div>
            <h3 class="text-sm font-semibold text-zinc-200 mb-1.5">Independent second-pair-of-eyes verification</h3>
            <p class="text-xs text-zinc-400 mb-4 leading-relaxed">
              Inspects candidate pull requests for security flaws, credentials, missing unit tests, and performance regressions before merge.
            </p>
            <div class="p-3 rounded bg-[#161619] border border-white/[0.07] font-mono text-[11px] text-zinc-300">
              <div class="text-zinc-500">Review Gate: Security + Coverage Passed</div>
              <div class="text-zinc-400">Signed off for automated merge</div>
            </div>
          </div>

        </div>

      </div>
    </section>

    <!-- ARCHITECTURE & HARNESS RUNTIME -->
    <section id="harness" class="py-20 border-b border-white/[0.07]">
      <div class="max-w-6xl mx-auto px-4 sm:px-6">
        
        <div class="max-w-2xl mb-12">
          <div class="text-xs font-mono uppercase tracking-widest text-zinc-500 mb-2">Runtime</div>
