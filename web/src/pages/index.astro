  <!-- CLIENT INTERACTIONS SCRIPT -->
  <script>
    // Tab switcher in demo preview
    const tabAll = document.getElementById('tab-all');
    const tabCaptain = document.getElementById('tab-captain');
    const tabBuild = document.getElementById('tab-build');
    const tabReview = document.getElementById('tab-review');
    const tabs = [tabAll, tabCaptain, tabBuild, tabReview].filter(Boolean) as HTMLElement[];

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        tabs.forEach(t => {
          t.classList.remove('bg-white/5', 'text-zinc-200', 'border', 'border-white/10');
          t.classList.add('text-zinc-400');
        });
        tab.classList.remove('text-zinc-400');
        tab.classList.add('bg-white/5', 'text-zinc-200', 'border', 'border-white/10');
        tabs.forEach(t => t.setAttribute('aria-pressed', String(t === tab)));
        
        const selected = tab.id.replace('tab-', '');
        document.querySelectorAll<HTMLElement>('[data-demo-agent]').forEach(panel => {
          panel.classList.toggle('hidden', panel.dataset.demoAgent !== selected);
        });
      });
    });

    // Replay interaction in demo
    const replayBtn = document.getElementById('hero-replay-btn');
    const demoConsole = document.getElementById('demo-step-display');
    if (replayBtn && demoConsole) {
      replayBtn.addEventListener('click', () => {
        replayBtn.textContent = 'Running...';
        demoConsole.style.opacity = '0.5';
        setTimeout(() => {
          demoConsole.style.opacity = '1';
          replayBtn.textContent = '✓ Replayed';
          setTimeout(() => {
            replayBtn.innerHTML = '<span class="w-1.5 h-1.5 rounded-full bg-[#2dd4bf]"></span><span>Replay run</span>';
          }, 1500);
        }, 500);
      });
    }
  </script>

