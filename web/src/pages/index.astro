---
import '../styles/tailwind.css';
---
<!DOCTYPE html>
<html lang="en" class="dark scroll-smooth">
<head>
  <meta charset="utf-8" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Shiba - The best AI software engineer</title>
  <!-- AI Coworker - The best AI software engineer -->
  <meta name="description" content="Shiba is the best AI software engineer. Delegate tasks to parallel coding agents that plan, build, and ship — from task to merged PR." />
  <link rel="canonical" href="https://tryshiba.dev/" />
  <link rel="sitemap" href="/sitemap.xml" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Shiba" />
  <meta property="og:url" content="https://tryshiba.dev/" />
  <meta property="og:title" content="Shiba - The best AI software engineer" />
  <meta property="og:description" content="Delegate tasks to parallel coding agents that plan, build, and ship — from task to merged PR." />
  <meta property="og:image" content="https://tryshiba.dev/assets/mascot/pet-logo.png" />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:site" content="@prince_twets" />
  <meta name="twitter:title" content="Shiba - The best AI software engineer" />
  <meta name="twitter:description" content="Delegate tasks to parallel coding agents that plan, build, and ship — from task to merged PR." />
  <meta name="twitter:image" content="https://tryshiba.dev/assets/mascot/pet-logo.png" />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "Shiba",
    url: "https://tryshiba.dev/",
    description: "Open-source, self-hosted AI software engineer: approval-gated coding tasks run in isolated Cloudflare Sandbox containers, from task to merged PR.",
    applicationCategory: "DeveloperApplication",
    operatingSystem: "Web",
    license: "https://opensource.org/licenses/MIT",
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
    sameAs: ["https://github.com/princepal9120/shiba", "https://x.com/prince_twets"],
  })} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />

  <style is:global>
    :root {
      --bg: #0b0b0b;
      --bg-raised: #111111;
      --bg-code: #0d1117;
      --border: rgba(255, 255, 255, 0.08);
      --border-strong: rgba(255, 255, 255, 0.14);
      --text: #ededed;
      --text-muted: #a1a1a1;
      --text-subtle: #8a8a8a;
      --cream: #f4f2f2;
      --ink: #0b0b0b;
      --ink-muted: #57534e;
      --green: #28a745;
      --green-fg: #3fb950;
      --red: #d73a49;
    }

    body {
      background-color: var(--bg);
      color: var(--text);
      font-family: 'Inter', system-ui, -apple-system, sans-serif;
      letter-spacing: -0.011em;
      margin: 0;
      padding: 0;
      overflow-x: hidden;
      -webkit-font-smoothing: antialiased;
    }

    .mono {
      font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
      letter-spacing: 0;
    }

    .eyebrow {
      font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 12px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--text-subtle);
    }
    .section-light .eyebrow { color: var(--ink-muted); }

    /* Hero backdrop: faint grid fading out from the top */
    .hero-grid {
      background-image: linear-gradient(to right, rgba(255, 255, 255, 0.05) 1px, transparent 1px),
                        linear-gradient(to bottom, rgba(255, 255, 255, 0.05) 1px, transparent 1px);
      background-size: 64px 64px;
      -webkit-mask-image: radial-gradient(ellipse 70% 60% at 50% 0%, #000 20%, transparent 75%);
      mask-image: radial-gradient(ellipse 70% 60% at 50% 0%, #000 20%, transparent 75%);
    }
    .hero-glow {
      background: radial-gradient(ellipse 50% 45% at 50% 0%, rgba(255, 255, 255, 0.07), transparent 70%);
    }
    .window-glow {
      background: radial-gradient(ellipse 55% 50% at 50% 30%, rgba(255, 255, 255, 0.06), transparent 70%);
    }

    /* Buttons: sizing and radius come from utilities */
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      font-weight: 500;
      line-height: 1;
      white-space: nowrap;
      cursor: pointer;
      transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease;
    }
    .btn-primary { background: var(--text); color: var(--ink); border: 1px solid var(--text); }
    .btn-primary:hover { background: #ffffff; border-color: #ffffff; }
    .btn-secondary { background: transparent; color: var(--text); border: 1px solid var(--border-strong); }
    .btn-secondary:hover { background: rgba(255, 255, 255, 0.05); border-color: rgba(255, 255, 255, 0.24); }

    .nav-link { color: var(--text-muted); transition: color 0.15s ease; }
    .nav-link:hover { color: var(--text); }

    /* Surfaces */
    .panel { background: var(--bg-raised); border: 1px solid var(--border); transition: border-color 0.2s ease; }
    .panel:hover { border-color: rgba(255, 255, 255, 0.16); }
    .well { background: var(--bg); border: 1px solid var(--border); }
    .window {
      background: #0f0f0f;
      border: 1px solid var(--border-strong);
      box-shadow: 0 40px 120px -40px rgba(0, 0, 0, 0.9);
    }
    .section-light { background: var(--cream); color: var(--ink); }
    .panel-light { background: #ffffff; border: 1px solid rgba(11, 11, 11, 0.08); transition: border-color 0.2s ease; }
    .panel-light:hover { border-color: rgba(11, 11, 11, 0.18); }

    .chip {
      display: inline-flex;
      align-items: center;
      gap: 0.375rem;
      padding: 0.1875rem 0.5rem;
      border-radius: 9999px;
      border: 1px solid var(--border-strong);
      color: var(--text-muted);
      font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 11px;
      line-height: 1.2;
      letter-spacing: 0;
      white-space: nowrap;
    }
    .chip-green { color: var(--green-fg); border-color: rgba(63, 185, 80, 0.35); background: rgba(46, 160, 67, 0.1); }
    .section-light .chip { color: var(--ink-muted); border-color: rgba(11, 11, 11, 0.14); }
    .check { color: var(--green-fg); }

    .icon-box {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 2.5rem;
      height: 2.5rem;
      border-radius: 10px;
      border: 1px solid var(--border);
      background: rgba(255, 255, 255, 0.03);
      color: var(--text);
      flex-shrink: 0;
    }

    .code-inline {
      font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 0.92em;
      color: var(--text);
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid var(--border);
      border-radius: 4px;
      padding: 0.05rem 0.3rem;
    }
    .mention { color: #1d9bd1; background: rgba(29, 155, 209, 0.12); border-radius: 3px; padding: 0 2px; }

    /* GitHub-dark diff + syntax */
    .diff-add, .diff-del { white-space: pre-wrap; overflow-wrap: anywhere; color: #e6edf3; }
    .diff-add { background-color: rgba(46, 160, 67, 0.15); box-shadow: inset 2px 0 0 var(--green); }
    .diff-del { background-color: rgba(215, 58, 73, 0.15); box-shadow: inset 2px 0 0 var(--red); }
    .diff-add .sign { color: #dafbe1; }
    .diff-del .sign { color: #ffdcd7; }
    .tok-k { color: #ff7b72; }
    .tok-s { color: #a5d6ff; }
    .tok-f { color: #d2a8ff; }
    .tok-v { color: #ffa657; }
    .tok-c { color: #8b949e; }

    /* Infinite logo strip */
    @keyframes marquee {
      from { transform: translateX(0); }
      to { transform: translateX(-50%); }
    }
    .marquee {
      display: flex;
      width: max-content;
      animation: marquee 40s linear infinite;
    }
    .marquee:hover { animation-play-state: paused; }
    .marquee-mask {
      -webkit-mask-image: linear-gradient(to right, transparent, #000 12%, #000 88%, transparent);
      mask-image: linear-gradient(to right, transparent, #000 12%, #000 88%, transparent);
    }

    @keyframes typing {
      0%, 60%, 100% { opacity: 0.25; }
      30% { opacity: 1; }
    }
    .typing-dot-1, .typing-dot-2, .typing-dot-3 { animation: typing 1s ease-in-out infinite; }
    .typing-dot-2 { animation-delay: 0.15s; }
    .typing-dot-3 { animation-delay: 0.3s; }

    /* Hero demo tabs: active state is driven by aria-pressed */
    .agent-tab {
      flex-shrink: 0;
      white-space: nowrap;
      min-height: 36px;
      border: 1px solid transparent;
      color: var(--text-muted);
      transition: color 0.15s ease, background-color 0.15s ease, border-color 0.15s ease;
    }
    .agent-tab:hover { color: var(--text); }
    .agent-tab[aria-pressed="true"] {
      color: var(--text);
      background: rgba(255, 255, 255, 0.06);
      border-color: var(--border-strong);
    }

    .resolve-btn {
      font-size: 12px;
      padding: 0.25rem 0.625rem;
      border-radius: 6px;
      border: 1px solid var(--border-strong);
      color: var(--text);
      cursor: pointer;
      white-space: nowrap;
      transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease;
    }
    .resolve-btn:hover { background: rgba(255, 255, 255, 0.06); }
    .resolve-btn.is-approved { color: var(--green-fg); border-color: rgba(63, 185, 80, 0.35); background: rgba(46, 160, 67, 0.1); }

    [hidden] { display: none !important; }
    :is(a, button, [tabindex]):focus-visible { outline: 2px solid var(--green); outline-offset: 3px; }
    main section { scroll-margin-top: 5rem; }
    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto !important; }
      *, *::before, *::after { animation: none !important; transition: none !important; }
    }

    @media (max-width: 639px) {
      header nav a, footer nav a {
        display: inline-flex;
        align-items: center;
        min-height: 44px;
      }
      #hero-replay-btn, .resolve-btn, .agent-tab { min-height: 44px; }
    }
  </style>
</head>
<body class="antialiased selection:bg-[#28a745]/40 selection:text-white grid-bg">

  <!-- HEADER -->
  <header class="sticky top-0 z-50 w-full border-b border-white/[0.06] bg-[#0b0b0b]/80 backdrop-blur-md">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-4">
      <a href="/" class="flex items-center gap-2.5 shrink-0 group">
        <img src="/assets/mascot/pet-logo.png" alt="Shiba AI" width="32" height="32" class="w-8 h-8 rounded-lg bg-white object-contain shadow-xs transition-transform group-hover:scale-105" />
        <div class="flex flex-col text-left leading-none">
          <span class="text-[15px] font-bold tracking-tight text-white leading-tight">Shiba AI</span>
          <span class="text-[11px] font-mono text-neutral-400 font-medium leading-tight">Worker</span>
        </div>
      </a>

      <nav aria-label="Main navigation" class="flex items-center gap-1 text-sm">
        <a href="#use-cases" class="nav-link hidden md:inline-flex px-3 py-2">Product</a>
        <a href="#integrations" class="nav-link hidden md:inline-flex px-3 py-2">Integrations</a>
        <a href="#security" class="nav-link hidden md:inline-flex px-3 py-2">Security</a>
        <a href="#pricing" class="nav-link hidden md:inline-flex px-3 py-2">Pricing</a>
        <a href="/docs/overview" class="nav-link inline-flex px-3 py-2">Docs</a>
        <a href="https://github.com/princepal9120/shiba" target="_blank" rel="noopener noreferrer" class="nav-link hidden sm:inline-flex items-center px-3 py-2" aria-label="Shiba on GitHub">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/></svg>
        </a>
        <a href="/app/" class="nav-link hidden sm:inline-flex px-3 py-2">Dashboard</a>
        <a href="/docs/getting-started" class="btn btn-primary h-9 px-3.5 ml-1 rounded-lg text-sm">Get started</a>
      </nav>
    </div>
  </header>

  <main>
    <!-- HERO -->
    <section class="relative isolate overflow-hidden pt-20 sm:pt-28 pb-6 text-center">
      <div class="hero-grid absolute inset-0 -z-10" aria-hidden="true"></div>
      <div class="hero-glow absolute inset-0 -z-10" aria-hidden="true"></div>
      <div class="max-w-4xl mx-auto px-4 sm:px-6">
        <div class="inline-flex max-w-full items-center gap-2 rounded-full border border-white/10 bg-white/[0.03] px-3 py-1 text-xs text-neutral-400 mb-8">
          <span class="size-1.5 shrink-0 rounded-full bg-[#3fb950]" aria-hidden="true"></span>
          <span class="truncate">Cloudflare native · Isolated Sandbox microVMs · 100% private</span>
        </div>

        <h1 class="text-[2.75rem] leading-[1.04] sm:text-6xl lg:text-[4.75rem] font-semibold tracking-[-0.045em] text-white text-balance mb-6 uppercase">
          <span class="block text-teal-400">THE BEST SELF-HOSTED</span>
          <span class="block text-white">AI SOFTWARE ENGINEER</span>
        </h1>

        <p class="text-lg sm:text-xl text-neutral-400 max-w-2xl mx-auto mb-10 leading-relaxed text-balance">
          Orchestrate a fleet of cloud coding agents in all of the apps your team already lives in.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
          <a href="/app/" class="btn btn-primary h-11 px-5 rounded-lg text-[15px] w-full sm:w-auto">
            <span>Open dashboard</span>
            <span aria-hidden="true">→</span>
          </a>
          <a href="/docs/getting-started" class="btn btn-secondary h-11 px-5 rounded-lg text-[15px] w-full sm:w-auto">
            Read the docs
          </a>
        </div>
      </div>
    </section>

    <!-- LOGO STRIP: OPEN SOURCE & CLOUDFLARE RUNTIMES -->
    <section aria-label="Built on" class="py-14">
      <p class="text-center text-sm text-neutral-400 mb-6 px-4">Built on modern open source and Cloudflare runtimes</p>
      <div class="marquee-mask relative w-full overflow-hidden">
        <div class="marquee">
          <ul class="flex items-center gap-12 pr-12 text-[15px] font-medium text-neutral-400 whitespace-nowrap">
            <li>Cloudflare Workers</li>
            <li>Sandbox Micro-Containers</li>
            <li>OpenCode Interpreter</li>
            <li>Claude Code Adapter</li>
            <li>Codex Runtime</li>
            <li>React 19 Dashboard</li>
            <li>Astro Starlight</li>
            <li>TypeScript 5.9</li>
            <li>397/397 Vitest Tests</li>
            <li>Cloudflare AI Gateway</li>
          </ul>
          <!-- Duplicate for continuous loop -->
          <ul aria-hidden="true" class="flex items-center gap-12 pr-12 text-[15px] font-medium text-neutral-400 whitespace-nowrap">
            <li>Cloudflare Workers</li>
            <li>Sandbox Micro-Containers</li>
            <li>OpenCode Interpreter</li>
            <li>Claude Code Adapter</li>
            <li>Codex Runtime</li>
            <li>React 19 Dashboard</li>
            <li>Astro Starlight</li>
            <li>TypeScript 5.9</li>
            <li>397/397 Vitest Tests</li>
            <li>Cloudflare AI Gateway</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- PRODUCT PREVIEW: MULTI-AGENT WORKSPACE -->
    <section aria-label="Product preview" class="pb-24 sm:pb-32">
      <div class="relative max-w-6xl mx-auto px-4 sm:px-6">
        <div class="window-glow absolute inset-x-0 -top-24 h-[520px] -z-10" aria-hidden="true"></div>

        <div class="window rounded-2xl overflow-hidden text-left">
          <!-- Titlebar -->
          <div class="flex flex-wrap items-center justify-between gap-3 border-b border-white/[0.08] px-4 py-3">
            <div class="flex items-center gap-3 min-w-0">
              <div class="flex gap-1.5" aria-hidden="true">
                <span class="size-3 rounded-full bg-white/10"></span>
                <span class="size-3 rounded-full bg-white/10"></span>
                <span class="size-3 rounded-full bg-white/10"></span>
              </div>
              <span class="mono text-xs text-neutral-400 truncate">
                <span class="text-neutral-200">shiba-orchestrator</span><span class="text-neutral-600 mx-1.5">/</span>task-SCO-15215
              </span>
            </div>

            <div class="flex items-center gap-2">
              <span class="chip">
                <span class="size-1.5 rounded-full bg-[#3fb950] animate-pulse" aria-hidden="true"></span>
                <span>Example workflow</span>
              </span>
              <button id="hero-replay-btn" type="button" class="btn btn-secondary h-8 px-3 rounded-lg text-xs">
                <svg fill="none" height="12" viewBox="0 0 14 14" width="12" xmlns="http://www.w3.org/2000/svg" class="size-3" aria-hidden="true">
                  <path d="M2.5 7C2.5 9.48528 4.51472 11.5 7 11.5C9.48528 11.5 11.5 9.48528 11.5 7C11.5 4.51472 9.48528 2.5 7 2.5C5.40879 2.5 4.00852 3.32376 3.19629 4.5625" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path>
                  <path d="M3 2V4.75H5.75" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"></path>
                </svg>
                <span>Replay run</span>
              </button>
            </div>
          </div>

          <!-- Agent view tabs -->
          <div role="group" aria-label="Agent view" class="flex items-center gap-1 overflow-x-auto border-b border-white/[0.08] px-3 py-2 text-[13px]">
            <button id="tab-all" type="button" aria-pressed="true" aria-controls="demo-step-display" class="agent-tab inline-flex items-center px-3 rounded-md">Pipeline view</button>
            <button id="tab-captain" type="button" aria-pressed="false" aria-controls="demo-step-display" class="agent-tab inline-flex items-center px-3 rounded-md">Captain (planner)</button>
            <button id="tab-build" type="button" aria-pressed="false" aria-controls="demo-step-display" class="agent-tab inline-flex items-center px-3 rounded-md">Build agent (sandbox)</button>
            <button id="tab-review" type="button" aria-pressed="false" aria-controls="demo-step-display" class="agent-tab inline-flex items-center px-3 rounded-md">Review agent (QA)</button>
            <button id="tab-terminal" type="button" aria-pressed="false" aria-controls="demo-step-display" class="agent-tab inline-flex items-center gap-1.5 px-3 rounded-md"><span class="mono text-xs" aria-hidden="true">&gt;_</span><span>Terminal log</span></button>
          </div>

          <!-- Workspace body -->
          <div id="demo-console-body" class="p-4 sm:p-6 min-h-[340px] flex flex-col justify-between">
            <div id="demo-step-display" class="space-y-3">
              <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-1 mono text-[11px] uppercase tracking-wider text-neutral-500 mb-1">
                <span>Orchestration pipeline · Task: fix sign-up form data & approval gates</span>
                <span class="text-neutral-400">Illustrative run · sample data</span>
              </div>

              <!-- Captain -->
              <div data-demo-agent="captain" class="flex items-start gap-3.5 rounded-xl border border-white/[0.08] bg-white/[0.02] p-4">
                <div class="icon-box !w-9 !h-9" aria-hidden="true">
                  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/></svg>
                </div>
                <div class="min-w-0 flex-1 space-y-1.5">
                  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-1.5">
                    <div class="flex flex-wrap items-center gap-2">
                      <span class="text-sm font-medium text-white">Captain: Spec & parallel delegation</span>
                      <span class="chip">Planning active</span>
                    </div>
                    <span class="mono text-[11px] text-neutral-500">00:00.12</span>
                  </div>
                  <p class="text-[13px] leading-relaxed text-neutral-400">
                    Deconstructed issue <span class="mono text-neutral-200">#15215</span>: booting isolated Sandbox microVM, applying patch to <code class="code-inline">src/auth/handler.ts</code>, delegating regression test sweep to Build Agent.
                  </p>
                </div>
              </div>

              <!-- Build agent -->
              <div data-demo-agent="build" class="flex items-start gap-3.5 rounded-xl border border-white/[0.08] bg-white/[0.02] p-4">
                <div class="icon-box !w-9 !h-9" aria-hidden="true">
                  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 17l6-6-6-6M12 19h8"/></svg>
                </div>
                <div class="min-w-0 flex-1 space-y-2">
                  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-1.5">
                    <div class="flex flex-wrap items-center gap-2">
                      <span class="text-sm font-medium text-white">Build Agent: Cloudflare Sandbox microVM</span>
                      <span class="chip">standard-1 VM</span>
                    </div>
                    <span class="mono text-[11px] text-neutral-400">Booted in 340ms</span>
                  </div>

