---
const { siteTitleHref = '/' } = Astro.locals?.starlightRoute ?? {};
---

<a href={siteTitleHref} class="site-title sl-flex items-center gap-2.5">
	<img
		class="h-7 w-7 rounded-md bg-white object-contain shrink-0"
		alt="Shiba AI Worker Logo"
		src="/assets/mascot/pet-logo.png"
		width="28"
		height="28"
	/>
	<span class="flex flex-col text-left leading-none" translate="no">
		<span class="text-[14px] font-bold tracking-tight text-white leading-tight">Shiba AI</span>
		<span class="text-[10px] font-mono text-neutral-400 font-medium leading-tight">Worker</span>
	</span>
</a>

<style>
	@layer starlight.core {
		.site-title {
			align-items: center;
			gap: 0.625rem;
			text-decoration: none;
			white-space: nowrap;
			min-width: 0;
		}
	}
</style>

