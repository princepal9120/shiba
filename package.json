{
  "name": "ai-intern",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted Cloudflare Workers app: approval-gated coding tasks delegated to isolated Sandbox containers running OpenCode.",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src dashboard test",
    "test": "vitest run",
    "test:live": "vitest run test/typesafe-live.test.ts",
    "build": "pnpm run build:dashboard && pnpm run docs:build && node scripts/copy-docs.mjs && pnpm run docs:verify",
    "docs:dev": "cd web && astro dev --port 4321",
    "docs:build": "astro build --root web",
    "docs:check": "astro check --root web",
    "build:dashboard": "vite build --config vite.config.ts",
    "docs:preview": "cd web && astro preview --port 4321",
    "docs:verify": "node scripts/check-docs.mjs"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.105",
    "@cloudflare/ai-chat": "0.12.0",
    "@cloudflare/sandbox": "0.12.9",
    "@cloudflare/think": "0.18.0",
    "agents": "0.23.0",
    "ai": "7.0.102",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "workers-ai-provider": "4.0.0",
    "zod": "4.3.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/starlight": "^0.42.1",
    "@astrojs/tailwind": "^6.0.2",
    "@cloudflare/workers-types": "^5.20260916.1",
    "@eslint/js": "^9.39.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "astro": "^7.3.2",
    "autoprefixer": "^10.6.1",
    "cookie": "^2.0.1",
    "eslint": "^9.39.5",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "wrangler": "4.118.0"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.34.4",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@mongodb-js/zstd",
      "core-js-pure",
      "esbuild",
      "node-liblzma",
      "workerd"
    ],
    "patchedDependencies": {
      "brace-expansion@5.0.12": "patches/brace-expansion@5.0.12.patch",
      "chat@4.40.0": "patches/chat@4.40.0.patch"
    }
  },
  "homepage": "https://shiba-intern.pages.dev/"
}
