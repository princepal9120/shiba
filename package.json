{
  "name": "shiba",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted Cloudflare Workers app: approval-gated coding tasks delegated to isolated Sandbox containers running OpenCode.",
  "type": "module",
  "scripts": {
    "build": "turbo run build && node scripts/assemble-public.mjs && pnpm run docs:verify",
    "build:dashboard": "turbo run build --filter=@shiba/frontend",
    "deploy": "pnpm build && alchemy deploy",
    "deploy:preview": "alchemy plan",
    "deploy:preview:wrangler": "node scripts/plan-deploy.mjs",
    "deploy:destroy": "alchemy destroy",
    "dev": "turbo run dev",
    "docs:build": "turbo run build --filter=@shiba/web",
    "docs:check": "pnpm -C apps/web check",
    "docs:dev": "pnpm -C apps/web dev",
    "docs:preview": "pnpm -C apps/web preview",
    "docs:verify": "node scripts/check-docs.mjs",
    "env:load": "varlock load",
    "env:scan": "varlock scan",
    "check": "biome check .",
    "format": "biome format --write .",
    "knip": "knip",
    "lint": "biome lint .",
    "lint:imports": "turbo run lint",
    "precommit": "biome check --write . && knip",
    "bootstrap": "node scripts/setup.mjs",
    "test": "turbo run test",
    "test:ephemeral": "node scripts/ephemeral-stack.mjs --alchemy",
    "test:live": "pnpm -C apps/backend test:live",
    "typecheck": "turbo run typecheck && tsc -b"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@effect/platform-bun": "4.0.0",
    "@effect/platform-node": "4.0.0",
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.13.6",

    "@types/react": "19.2.18",
    "alchemy": "2.0.0-beta.80",
    "effect": "4.0.0",
    "eslint": "^9.39.5",
    "knip": "6.37.0",
    "turbo": "2.10.13",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.70.0",
    "varlock": "1.20.0",
    "vite": "8.3.0",
    "wrangler": "4.118.0"
  },
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.34.4",
  "homepage": "https://shiba-intern.pages.dev/",
  "pnpm": {
    "overrides": {
      "jiti": "2.7.0",
      "chat": "4.40.0",
      "@cloudflare/puppeteer>@puppeteer/browsers": "3.2.2",
      "http-cache-semantics": "4.3.0",
      "@modelcontextprotocol/server": "2.3.1"
    }
  }
}