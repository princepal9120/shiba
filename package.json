{
  "name": "shiba-ai-coworker",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted Cloudflare Workers app: approval-gated coding tasks delegated to isolated Sandbox containers running OpenCode.",
  "type": "module",
  "scripts": {
    "build": "turbo run build && node scripts/copy-docs.mjs && pnpm run docs:verify",
    "build:dashboard": "turbo run build --filter=@shiba-ai-coworker/frontend",
    "deploy": "alchemy deploy",
    "deploy:preview": "alchemy plan",
    "deploy:preview:wrangler": "node scripts/plan-deploy.mjs",
    "deploy:destroy": "alchemy destroy",
    "dev": "turbo run dev --filter=@shiba-ai-coworker/frontend",
    "docs:build": "turbo run build --filter=@shiba-ai-coworker/web",
    "docs:check": "pnpm -C apps/web check",
    "docs:dev": "pnpm -C apps/web dev",
    "docs:preview": "pnpm -C apps/web preview",
    "docs:verify": "node scripts/check-docs.mjs",
    "lint": "turbo run lint",
    "setup": "node scripts/setup.mjs",
    "test": "turbo run test",
    "test:ephemeral": "node scripts/ephemeral-stack.mjs --alchemy",
    "test:live": "pnpm -C apps/backend test:live",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@effect/platform-bun": "4.0.0-rc.117",
    "@effect/platform-node": "4.0.0-rc.117",
    "@eslint/js": "^9.39.5",
    "@types/react": "19.2.18",
    "alchemy": "2.0.0-beta.79",
    "effect": "4.0.0-rc.117",
    "eslint": "^9.39.5",
    "turbo": "2.10.13",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "8.3.0",
    "wrangler": "4.118.0"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.34.4",
  "homepage": "https://shiba-ai-coworker.pages.dev/"
}
