{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        "public/**",
        ".astro/**",
        "../../public/**"
      ]
    },
    "typecheck": {
      "cache": false,
      "outputs": []
    },
    "test": {
      "cache": false,
      "outputs": [
        "coverage/**"
      ]
    },
    "lint": {
      "cache": false,
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
