{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "noFallthroughCasesInSwitch": true,
    "types": [
      "vite/client"
    ],
    "baseUrl": ".",
    "paths": {
      "react": [
        "./apps/frontend/node_modules/@types/react",
        "./node_modules/@types/react"
      ],
      "react/jsx-runtime": [
        "./apps/frontend/node_modules/@types/react/jsx-runtime",
        "./node_modules/@types/react/jsx-runtime"
      ]
    }
  },
  "include": [
    "apps/backend/src",
    "apps/backend/test",
    "apps/frontend/src",
    "apps/frontend/vite.config.ts",
    "apps/backend/vitest.config.ts",
    "alchemy.run.ts"
  ]
}
