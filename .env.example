# Copy to .env (gitignored) or run `pnpm run bootstrap`, which writes it for you.
# alchemy.run.ts loads this file; every secret present here is bound on deploy,
# and any secret missing here is REMOVED from the Worker on the next deploy.
#
# Declared in .env.schema (varlock) — add new vars there too, then validate
# with `pnpm env:load` and leak-check with `pnpm env:scan`.

# Cloudflare Access — who can open the dashboard (web + iPhone)
ACCESS_EMAILS=you@example.com
# The <x> in https://shiba-ai-coworker.<x>.workers.dev
WORKERS_SUBDOMAIN=
# Public dashboard hostname — feeds https://<host>/api/screenshots/<id> links
# (same-origin path; safe to set to the custom domain). Unset = PR screenshots
# are captured but have no public URL.
#   WORKER_HOSTNAME=

# Optional: skip if `npx alchemy provider cloudflare token` stored a profile
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Secrets
GITHUB_TOKEN=
AI_GATEWAY_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
SLACK_APPROVERS=
SLACK_CHANNEL_REPOS=
# Slack channel for approval messages (optional)
#   SLACK_APPROVALS_CHANNEL=
GITHUB_WEBHOOK_SECRET=
TYPESAFE_API_KEY=
DEVIN_API_KEY=

# Built-in dashboard auth (unset = lane dark; >=32 chars turns it on)
BETTER_AUTH_SECRET=
# Canonical dashboard URL for cookie scope/origin checks (optional)
BETTER_AUTH_URL=

# Subscription lanes — each pair is flag + credential (all unset = lane dark).
# Per-account credentials resolve as <NAME>_<ACCOUNT> at egress.
#   SHIBA_CLAUDE_SUBSCRIPTION=1
#   CLAUDE_SUBSCRIPTION_TOKEN=       `claude setup-token` output
#   CLAUDE_SUBSCRIPTION_MODEL=       per-deploy model override
#   SHIBA_CODEX_SUBSCRIPTION=1
#   CODEX_SUBSCRIPTION_AUTH_JSON=    `codex login` auth.json contents verbatim
#   CODEX_SUBSCRIPTION_MODEL=
#   SHIBA_ANTIGRAVITY_SUBSCRIPTION=1
#   ANTIGRAVITY_SUBSCRIPTION_MODEL=  (in-container OAuth — no token var)
#   SHIBA_CURSOR_SUBSCRIPTION=1
#   CURSOR_SUBSCRIPTION_TOKEN=       the operator's Cursor Agent API key
#   CURSOR_SUBSCRIPTION_MODEL=
#   SHIBA_DEVIN_SUBSCRIPTION=1
#   DEVIN_SUBSCRIPTION_TOKEN=        the operator's Devin API key/session token
#   DEVIN_SUBSCRIPTION_MODEL=

# T51 local runtime (all unset = dark):
#   SHIBA_LOCAL_RUNTIME=1        admits runtime:"local" on the dashboard + opens /api/local
#   LOCAL_ADAPTER_TOKEN=         bearer the `shiba local` daemon presents on /api/local/*

# Feature flags (plain vars, never secrets):
#   AUTOMATIONS_ENABLED=1        the automations scheduler loop
#   MEMORY_ENABLED=1             memory subsystem (Vectorize + Memory DO)
#   REQUIRE_ACCESS=              set by alchemy live deploys — do not set locally
#   ALCHEMY_STATE_BACKEND=       `cloudflare` = CF state store; unset = local files

# Harness + model picks:
#   AGENT_HARNESS=               opencode | claude-code | codex | devin | grok | *-acp lanes
#   CLAUDE_CODE_MODEL= / CODEX_MODEL= / DEVIN_MODEL= / GROK_MODEL=
#   ROLE_MODEL_MAP=              one JSON object, e.g. {"fixer":{"harness":"opencode","model":"opencode-go/deepseek-v3.2"}}
#   ROLE_MODEL__<ROLE>=          single "harness/model" or bare "harness" pin
#                                (ORCHESTRATOR | EXPLORER | FIXER | REVIEWER | DESIGNER)

# Telegram lane (all unset = dark):
#   TELEGRAM_BOT_TOKEN=          @BotFather token — POST /api/telegram/webhook
#   TELEGRAM_WEBHOOK_SECRET=     secret header Telegram must present
#   TELEGRAM_APPROVERS=          approver user ids
#   TELEGRAM_CHAT_REPOS=         chat→repo routing map
#   TELEGRAM_AGENT_HARNESS=      per-channel harness override (blank = AGENT_HARNESS)

# Discord lane (all unset = dark):
#   DISCORD_PUBLIC_KEY=          app Ed25519 key — verifies POST /api/discord/interactions
#   DISCORD_APPROVERS=           approver user ids
#   DISCORD_CHANNEL_REPOS=       channel→repo routing map
#   DISCORD_AGENT_HARNESS=       per-channel harness override

# Usage surfaces:
#   USAGE_BUDGET_USD=            optional daily budget shown on the usage card

# Agent mailbox identity — the address the MCP latest_verification tool
# scans when no mailbox is given (default dev@tryshiba.dev):
#   AGENT_MAILBOX=               the agent's registered inbox address
