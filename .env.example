# Copy to .env (gitignored) or run `pnpm run bootstrap`, which writes it for you.
# alchemy.run.ts loads this file; every secret present here is bound on deploy,
# and any secret missing here is REMOVED from the Worker on the next deploy.
#
# Declared in .env.schema (varlock) — add new vars there too, then validate
# with `pnpm env:load` and leak-check with `pnpm env:scan`.

# Cloudflare Access — who can open the dashboard (web + iPhone)
ACCESS_EMAILS=you@example.com
# The <x> in https://shiba-ai-coworker.<x>.workers.dev
WORKERS_SUBDOMAIN=

# Optional: skip if `npx alchemy provider cloudflare token` stored a profile
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Secrets
GITHUB_TOKEN=
AI_GATEWAY_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
SLACK_APPROVERS=
SLACK_CHANNEL_REPOS=
GITHUB_WEBHOOK_SECRET=
TYPESAFE_API_KEY=
DEVIN_API_KEY=

# T51 local runtime (all unset = dark):
#   SHIBA_LOCAL_RUNTIME=1        admits runtime:"local" on the dashboard + opens /api/local
#   LOCAL_ADAPTER_TOKEN=         bearer the `shiba local` daemon presents on /api/local/*

# cursor/devin subscription lanes (all unset = dark):
#   SHIBA_CURSOR_SUBSCRIPTION=1  opens /api/auth/cursor-subscription
#   CURSOR_SUBSCRIPTION_TOKEN=   the operator's Cursor Agent API key
#   CURSOR_SUBSCRIPTION_MODEL=   per-deploy model override
#   SHIBA_DEVIN_SUBSCRIPTION=1   opens /api/auth/devin-subscription
#   DEVIN_SUBSCRIPTION_TOKEN=    the operator's Devin API key/session token
#   DEVIN_SUBSCRIPTION_MODEL=    per-deploy model override

# Agent mailbox identity — the address the MCP latest_verification tool
# scans when no mailbox is given (default dev@tryshiba.dev):
#   AGENT_MAILBOX=               the agent's registered inbox address
